@page "/notas"
@layout AppLayout
@attribute [Authorize(Policy = "Docencia")]
@inject UiSession Session
@inject AcademicService Academic

<PageTitle>Notas | EduAssess</PageTitle>

<PageHeader Eyebrow="Avaliação" Title="Notas" Subtitle="@(Session.IsProfessor ? "Lance notas para os alunos das suas turmas, nas disciplinas sob sua responsabilidade." : "Registre avaliações por matrícula e disciplina e acompanhe o histórico.")" />

<Feedback Message="@message" IsError="@isError" />

<div class="cols">
    <div class="card sticky">
        <div class="card-head"><div><h2>Lançar nota</h2><p>Escala de 0 a 10.</p></div></div>
        @if (enrollments is not null && (enrollments.Count == 0 || disciplines!.Count == 0))
        {
            <div class="hint" style="margin-top:0">
                @if (enrollments.Count == 0) { <span>Não há matrículas ativas@(Session.IsProfessor ? " nas suas turmas" : "").</span> }
                @if (disciplines!.Count == 0) { <span> Não há disciplinas @(Session.IsProfessor ? "sob sua responsabilidade" : "ativas") — @(Session.CanManage ? "cadastre em Disciplinas." : "peça a um gestor para vinculá-las a você.")</span> }
            </div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="CreateAsync" FormName="nota">
                <DataAnnotationsValidator />
                <div class="field"><label for="n-mat">Aluno / turma</label>
                    <InputSelect id="n-mat" class="select" @bind-Value="form.EnrollmentId">
                        <option value="">Selecione</option>
                        @foreach (var item in enrollments ?? new()) { <option value="@item.Id">@item.Label</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.EnrollmentId)" />
                </div>
                <div class="field"><label for="n-disc">Disciplina</label>
                    <InputSelect id="n-disc" class="select" @bind-Value="form.DisciplineId">
                        <option value="">Selecione</option>
                        @foreach (var item in disciplines ?? new()) { <option value="@item.Id">@item.Name</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.DisciplineId)" />
                </div>
                <div class="form-row">
                    <div class="field"><label for="n-desc">Avaliação</label><InputText id="n-desc" class="input" @bind-Value="form.Description" placeholder="Ex.: Prova 1" /><ValidationMessage For="@(() => form.Description)" /></div>
                    <div class="field"><label for="n-val">Nota</label><InputNumber id="n-val" class="input" @bind-Value="form.Value" step="0.1" min="0" max="10" /><ValidationMessage For="@(() => form.Value)" /></div>
                </div>
                <button class="btn btn-primary" type="submit" disabled="@busy">Lançar nota</button>
            </EditForm>
        }
    </div>

    <div class="card">
        <div class="card-head"><div><h2>Notas lançadas</h2><p>@(Session.IsProfessor ? "Notas dos alunos das suas turmas." : "Todas as notas da instituição.")</p></div><span class="count-pill">@(grades?.Count ?? 0)</span></div>
        @if (grades is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (grades.Count == 0)
        {
            <EmptyState IconName="pen" Title="Nenhuma nota lançada" Text="As avaliações registradas aparecerão aqui." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Aluno</th><th>Disciplina</th><th>Lançamento</th><th class="num">Nota</th></tr></thead>
                    <tbody>
                        @foreach (var item in grades)
                        {
                            <tr>
                                <td><strong>@item.StudentName</strong><span class="cell-sub">@item.ClassName</span></td>
                                <td>@item.DisciplineName<span class="cell-sub">@item.Description</span></td>
                                <td>@UiFormat.Date(item.CreatedAt)<span class="cell-sub">por @item.LaunchedBy</span></td>
                                <td class="num"><GradeBadge Value="item.Value" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<GradeRow>? grades;
    private List<EnrollmentOption>? enrollments;
    private List<DisciplineOption>? disciplines;
    private readonly GradeForm form = new();
    private string? message;
    private bool isError;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            enrollments = await Academic.GetEnrollmentOptionsAsync();
            disciplines = await Academic.GetDisciplineOptionsAsync();
            grades = await Academic.GetGradesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            message = ex.Message; isError = true;
            enrollments ??= new(); disciplines ??= new(); grades ??= new();
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        try
        {
            await Academic.CreateGradeAsync(form.EnrollmentId ?? Guid.Empty, form.DisciplineId ?? Guid.Empty, form.Description, form.Value);
            message = "Nota lançada com sucesso."; isError = false;
            form.Description = ""; form.Value = 0;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException) { message = ex.Message; isError = true; }
        finally { busy = false; }
    }

    private sealed class GradeForm
    {
        [Required(ErrorMessage = "Selecione o aluno.")]
        public Guid? EnrollmentId { get; set; }

        [Required(ErrorMessage = "Selecione a disciplina.")]
        public Guid? DisciplineId { get; set; }

        [Required(ErrorMessage = "Informe a avaliação.")]
        [StringLength(120, MinimumLength = 2, ErrorMessage = "Use entre 2 e 120 caracteres.")]
        public string Description { get; set; } = "";

        [Range(typeof(decimal), "0", "10", ErrorMessage = "A nota deve estar entre 0 e 10.")]
        public decimal Value { get; set; }
    }
}
