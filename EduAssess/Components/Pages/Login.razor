@page "/"
@page "/login"
@layout AuthLayout
@using global::EduAssess.Data
@inject UiSession Session
@inject NavigationManager Navigation

<PageTitle>Entrar | Faculdade Luciano Feijão</PageTitle>

<div class="auth">
    <aside class="auth-aside">
        <Logo Light="true" />
        <div>
            <div class="eyebrow">Aprender · Evoluir · Conquistar</div>
            <h1>O próximo passo da educação começa <span class="mark">aqui.</span></h1>
            <p>Acompanhe suas turmas, notas e treine com questões da sua faculdade, tudo em um só lugar.</p>
            <ul class="auth-points">
                <li><Icon Name="check-circle" Size="20" /> Painel próprio para cada perfil</li>
                <li><Icon Name="check-circle" Size="20" /> Notas e médias sempre atualizadas</li>
                <li><Icon Name="check-circle" Size="20" /> Questões para praticar a qualquer hora</li>
                <li><Icon Name="check-circle" Size="20" /> Acesso protegido e auditado</li>
            </ul>
        </div>
        @* NOVO: escolha do prédio. Cada link abre o login com as cores daquele prédio. *@
        <div class="auth-units" role="group" aria-label="Escolha o seu prédio">
            @foreach (var c in UiTheme.LoginUnits)
            {
                <a href="/login?unidade=@c.Key" class="@(CurrentUnit == c.Key ? "on" : "")" aria-current="@(CurrentUnit == c.Key ? "true" : null)">
                    <Icon Name="@c.Icon" Size="16" /> @c.Name
                </a>
            }
        </div>

        <div class="auth-foot">FACULDADE LUCIANO FEIJÃO · EDUASSESS</div>
    </aside>

    <section class="auth-main">
        <div class="auth-card">
            <div class="eyebrow">Bem-vindo de volta</div>
            <h2>Acesse sua conta</h2>
            <p class="sub">Entre com suas credenciais para continuar.</p>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-error" role="alert"><Icon Name="alert" Size="18" /><span>@ErrorMessage</span></div>
            }

            <form method="post" action="/ui/login">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <input type="hidden" name="unidade" value="@CurrentUnit" />
                <div class="field">
                    <label for="email">E-mail</label>
                    <input id="email" name="email" type="email" class="input" value="@Email" placeholder="voce@instituicao.edu.br" autocomplete="username" required maxlength="150" />
                </div>
                <div class="field">
                    <label for="password">Senha</label>
                    <input id="password" name="password" type="password" class="input" placeholder="Digite sua senha" autocomplete="current-password" required maxlength="72" />
                </div>
                <label class="check" style="margin-bottom:22px"><input type="checkbox" name="remember" /> Manter conectado neste dispositivo</label>
                <button class="btn btn-primary btn-lg btn-block" type="submit">Entrar na plataforma <Icon Name="arrow-right" Size="18" /></button>
            </form>

            <p class="auth-switch">Ainda não tem conta? <a href="/cadastro">Criar conta</a></p>

            @if (ShowDemoHint)
            {
                <div class="auth-demo">
                    <b>Ambiente de desenvolvimento</b>
                    Admin: <code>@DatabaseInitializer.DevAdminEmail</code> / <code>@DatabaseInitializer.DevAdminPassword</code><br />
                    Demo: <code>gestor@eduassess.demo</code>, <code>professor@eduassess.demo</code>, <code>aluno@eduassess.demo</code> / <code>@DatabaseInitializer.DemoPassword</code>
                </div>
            }
        </div>
    </section>
</div>

@code {
    // NOVO: prédio escolhido na URL (/login?unidade=medicina); só serve para as cores da tela de login.
    [SupplyParameterFromQuery(Name = "unidade")] public string? Unit { get; set; }
    private string CurrentUnit => UiTheme.NormalizeLoginUnit(Unit);

    [Inject] private IHostEnvironment Environment { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "erro")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "email")] private string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "ReturnUrl")] private string? ReturnUrl { get; set; }

    private bool ShowDemoHint => Environment.IsDevelopment();

    private string? ErrorMessage => Error switch
    {
        "credenciais" => "E-mail ou senha incorretos. Confira os dados e tente novamente.",
        "campos" => "Informe o e-mail e a senha para entrar.",
        null or "" => null,
        _ => "Não foi possível entrar. Tente novamente."
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.User is not null)
            Navigation.NavigateTo(UiFormat.HomePath(Session.User.Role), forceLoad: true);
    }
}
