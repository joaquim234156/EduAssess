@page "/turmas"
@layout AppLayout
@attribute [Authorize(Policy = "Gestao")]
@inject AcademicService Academic

<PageTitle>Turmas | EduAssess</PageTitle>

<PageHeader Eyebrow="Instituição" Title="Turmas" Subtitle="Organize as turmas por curso e defina o professor responsável por cada uma." />

<Feedback Message="@message" IsError="@isError" />

<div class="cols">
    <div class="card sticky">
        <div class="card-head"><div><h2>Nova turma</h2><p>Escolha o curso e o professor.</p></div></div>
        @if (courses is not null && (courses.Count == 0 || teachers!.Count == 0))
        {
            <div class="hint" style="margin-top:0">
                Para criar uma turma é preciso ter ao menos um
                @if (courses.Count == 0) { <a href="/cursos"><b>curso</b></a> }
                @if (courses.Count == 0 && teachers!.Count == 0) { <span> e um </span> }
                @if (teachers!.Count == 0) { <a href="/equipe"><b>professor</b></a> }
                cadastrado.
            </div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="CreateAsync" FormName="turma">
                <DataAnnotationsValidator />
                <div class="field"><label for="t-nome">Nome da turma</label><InputText id="t-nome" class="input" @bind-Value="form.Name" placeholder="Ex.: Administração — Noite" /><ValidationMessage For="@(() => form.Name)" /></div>
                <div class="field"><label for="t-curso">Curso</label>
                    <InputSelect id="t-curso" class="select" @bind-Value="form.CourseId">
                        <option value="">Selecione</option>
                        @foreach (var course in courses ?? new()) { <option value="@course.Id">@course.Name</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.CourseId)" />
                </div>
                <div class="field"><label for="t-prof">Professor responsável</label>
                    <InputSelect id="t-prof" class="select" @bind-Value="form.TeacherId">
                        <option value="">Selecione</option>
                        @foreach (var teacher in teachers ?? new()) { <option value="@teacher.Id">@teacher.Name</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.TeacherId)" />
                </div>
                <button class="btn btn-primary" type="submit" disabled="@busy">Criar turma</button>
            </EditForm>
        }
    </div>

    <div class="card">
        <div class="card-head"><div><h2>Turmas ativas</h2><p>Alunos matriculados em cada turma.</p></div><span class="count-pill">@(classes?.Count ?? 0)</span></div>
        @if (classes is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (classes.Count == 0)
        {
            <EmptyState IconName="layers" Title="Nenhuma turma criada" Text="Crie a primeira turma para começar a matricular alunos." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Turma</th><th>Curso</th><th>Professor</th><th class="num">Alunos</th></tr></thead>
                    <tbody>
                        @foreach (var item in classes)
                        {
                            <tr>
                                <td><strong>@item.Name</strong><span class="cell-sub">@item.Period º período</span></td>
                                <td>@item.CourseName</td>
                                <td><div class="person"><div class="avatar sm">@UiFormat.Initials(item.InstructorName)</div>@item.InstructorName</div></td>
                                <td class="num"><span class="badge badge-gray">@item.StudentCount</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<ClassRow>? classes;
    private List<CourseRow>? courses;
    private List<InstructorRow>? teachers;
    private readonly ClassForm form = new();
    private string? message;
    private bool isError;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            courses = await Academic.GetCoursesAsync();
            teachers = await Academic.GetInstructorsAsync();
            classes = await Academic.GetClassesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            message = ex.Message; isError = true;
            courses ??= new(); teachers ??= new(); classes ??= new();
        }
    }

    private async Task CreateAsync()
    {
        busy = true;
        try
        {
            await Academic.CreateClassAsync(form.Name, form.CourseId ?? Guid.Empty, form.TeacherId ?? Guid.Empty);
            message = "Turma criada com sucesso."; isError = false;
            form.Name = ""; form.CourseId = null; form.TeacherId = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException) { message = ex.Message; isError = true; }
        finally { busy = false; }
    }

    private sealed class ClassForm
    {
        [Required(ErrorMessage = "Informe o nome da turma.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "Use entre 2 e 150 caracteres.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Selecione o curso.")]
        public Guid? CourseId { get; set; }

        [Required(ErrorMessage = "Selecione o professor.")]
        public Guid? TeacherId { get; set; }
    }
}
