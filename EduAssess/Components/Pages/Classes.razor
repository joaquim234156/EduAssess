@page "/turmas"
@layout AppLayout
@attribute [Authorize(Policy = "Gestao")]
@inject AcademicService Academic

<PageTitle>Turmas | EduAssess</PageTitle>

<PageHeader Eyebrow="Instituição" Title="Turmas" Subtitle="Organize as turmas por curso e defina o professor responsável por cada uma." />

<Feedback Message="@message" IsError="@isError" />

<div class="cols">
    <div class="card sticky">
        <div class="card-head"><div><h2>@(editingId is null ? "Nova turma" : "Editar turma")</h2><p>Escolha o curso e o professor.</p></div></div>
        @if (courses is not null && (courses.Count == 0 || teachers!.Count == 0))
        {
            <div class="hint" style="margin-top:0">
                Para criar uma turma é preciso ter ao menos um
                @if (courses.Count == 0) { <a href="/cursos"><b>curso</b></a> }
                @if (courses.Count == 0 && teachers!.Count == 0) { <span> e um </span> }
                @if (teachers!.Count == 0) { <a href="/equipe"><b>professor</b></a> }
                cadastrado.
            </div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="turma">
                <DataAnnotationsValidator />
                <div class="field"><label for="t-nome">Nome da turma</label><InputText id="t-nome" class="input" @bind-Value="form.Name" placeholder="Ex.: Administração — Noite" /><ValidationMessage For="@(() => form.Name)" /></div>
                <div class="field"><label for="t-curso">Curso</label>
                    <InputSelect id="t-curso" class="select" @bind-Value="form.CourseId">
                        <option value="">Selecione</option>
                        @foreach (var course in courses ?? new()) { <option value="@course.Id">@course.Name</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.CourseId)" />
                </div>
                <div class="field"><label for="t-prof">Professor responsável</label>
                    <InputSelect id="t-prof" class="select" @bind-Value="form.TeacherId">
                        <option value="">Selecione</option>
                        @foreach (var teacher in teachers ?? new()) { <option value="@teacher.Id">@teacher.Name</option> }
                    </InputSelect>
                    <ValidationMessage For="@(() => form.TeacherId)" />
                </div>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit" disabled="@busy">@(editingId is null ? "Criar turma" : "Salvar alterações")</button>
                    @if (editingId is not null) { <button class="btn btn-ghost" type="button" @onclick="CancelEdit">Cancelar</button> }
                </div>
            </EditForm>
        }
    </div>

    <div class="card">
        <div class="card-head"><div><h2>@(showInactive ? "Todas as turmas" : "Turmas ativas")</h2><p>Alunos matriculados em cada turma.</p></div><div class="row-actions"><button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleInactive">@(showInactive ? "Mostrar ativas" : "Mostrar inativas")</button><span class="count-pill">@(classes?.Count ?? 0)</span></div></div>
        @if (classes is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (classes.Count == 0)
        {
            <EmptyState IconName="layers" Title="Nenhuma turma criada" Text="Crie a primeira turma para começar a matricular alunos." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Turma</th><th>Curso</th><th>Professor</th><th>Status</th><th class="num">Alunos</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in classes)
                        {
                            <tr class="@(item.Active ? "" : "inactive-row")">
                                <td><strong>@item.Name</strong><span class="cell-sub">@item.Period º período</span></td>
                                <td>@item.CourseName</td>
                                <td><div class="person"><div class="avatar sm">@UiFormat.Initials(item.InstructorName)</div>@item.InstructorName</div></td>
                                <td><span class="badge @(item.Active ? "badge-green" : "badge-gray")">@(item.Active ? "Ativa" : "Inativa")</span></td>
                                <td class="num"><span class="badge badge-gray">@item.StudentCount</span></td>
                                <td><div class="row-actions">
                                    <button class="btn-text" type="button" @onclick="() => Edit(item)">Editar</button>
                                    @if (item.Active)
                                    {
                                        <button class="btn-text danger" type="button" @onclick="() => AskDisable(item)">Desativar</button>
                                    }
                                    else
                                    {
                                        <button class="btn-text" type="button" @onclick="() => SetActiveAsync(item, true)">Reativar</button>
                                    }
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<Modal Open="disableTarget is not null" Eyebrow="Desativar turma" Title="@(disableTarget?.Name ?? "")" OnClose="CancelDisable">
    <ChildContent>
        <p>A turma deixará de ficar disponível para novas matrículas. Matrículas e notas existentes serão preservadas. Deseja continuar?</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelDisable">Cancelar</button>
        <button type="button" class="btn btn-danger" disabled="@busy" @onclick="ConfirmDisableAsync">Desativar turma</button>
    </Footer>
</Modal>

@code {
    private List<ClassRow>? classes;
    private List<CourseRow>? courses;
    private List<InstructorRow>? teachers;
    private ClassForm form = new();
    private Guid? editingId;
    private ClassRow? disableTarget;
    private bool showInactive;
    private string? message;
    private bool isError;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            courses = await Academic.GetCoursesAsync();
            teachers = await Academic.GetInstructorsAsync();
            classes = await Academic.GetClassesAsync(showInactive);
        }
        catch (UnauthorizedAccessException ex)
        {
            message = ex.Message; isError = true;
            courses ??= new(); teachers ??= new(); classes ??= new();
        }
    }

    private async Task ToggleInactive()
    {
        showInactive = !showInactive;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            await Academic.SaveClassAsync(editingId, form.Name, form.CourseId ?? Guid.Empty, form.TeacherId ?? Guid.Empty);
            message = editingId is null ? "Turma criada com sucesso." : "Turma atualizada com sucesso."; isError = false;
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; isError = true; }
        finally { busy = false; }
    }

    private void Edit(ClassRow item)
    {
        editingId = item.Id;
        form = new ClassForm { Name = item.Name, CourseId = item.CourseId, TeacherId = item.InstructorId };
        message = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        form = new ClassForm();
    }

    private void AskDisable(ClassRow item) => disableTarget = item;
    private void CancelDisable() => disableTarget = null;

    private async Task ConfirmDisableAsync()
    {
        if (disableTarget is null) return;
        var item = disableTarget;
        disableTarget = null;
        await SetActiveAsync(item, false);
    }

    private async Task SetActiveAsync(ClassRow item, bool active)
    {
        busy = true;
        try
        {
            await Academic.SetClassActiveAsync(item.Id, active);
            message = active ? $"Turma “{item.Name}” reativada." : $"Turma “{item.Name}” desativada.";
            isError = false;
            if (!active && editingId == item.Id) CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; isError = true; }
        finally { busy = false; }
    }

    private sealed class ClassForm
    {
        [Required(ErrorMessage = "Informe o nome da turma.")]
        [StringLength(150, MinimumLength = 2, ErrorMessage = "Use entre 2 e 150 caracteres.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Selecione o curso.")]
        public Guid? CourseId { get; set; }

        [Required(ErrorMessage = "Selecione o professor.")]
        public Guid? TeacherId { get; set; }
    }
}
