@using global::EduAssess.Models.Local
@inherits LayoutComponentBase
@implements IDisposable
@inject UiSession Session

@* ALTERADO: o elemento raiz agora recebe as classes de tema (perfil + prédio), ex.: "role-professor unit-medicina".
   Todo o visual exclusivo está em temas.css. O fundo fixo em linha foi para o CSS (.shell { background: var(--paper) }). *@
<div class="shell @Session.ThemeClass" style="@Session.ThemeStyle">
    <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" checked="@menuOpen" @onchange="OnMenuChanged" />
    <aside class="sidebar">
        <Logo Light="@(!UiTheme.LightSidebar(Session.User?.Role))" Href="@homePath" />

        @* NOVO: selo do prédio (Principal, Medicina, Odontologia) na barra lateral. *@
        @if (Session.IsSignedIn)
        {
            <div class="unit-badge" title="@Session.ThemeLabel">
                <span class="ub-ico"><Icon Name="@UiTheme.KeyIcon(Session.ThemeKey)" Size="20" /></span>
                <div>
                    <small>@Session.InstitutionName</small>
                    <strong>@(Session.ThemeKey == "rede" ? "Todas as unidades" : Session.ThemeLabel)</strong>
                </div>
            </div>
        }

        @if (Session.IsSignedIn)
        {
            @if (Session.CanManage)
            {
                <div class="nav-group">
                    <span>Instituição</span>
                    <NavLink class="nav-link" href="/painel" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Visão geral</NavLink>
                    <NavLink class="nav-link" href="/instituicao" @onclick="CloseMenu"><Icon Name="building" /> Unidades e pessoas</NavLink>
                    <NavLink class="nav-link" href="/cursos" @onclick="CloseMenu"><Icon Name="book" /> Cursos</NavLink>
                    <NavLink class="nav-link" href="/disciplinas" @onclick="CloseMenu"><Icon Name="file" /> Disciplinas</NavLink>
                    <NavLink class="nav-link" href="/turmas" @onclick="CloseMenu"><Icon Name="layers" /> Turmas</NavLink>
                </div>
                <div class="nav-group">
                    <span>Pessoas</span>
                    <NavLink class="nav-link" href="/equipe" @onclick="CloseMenu"><Icon Name="users" /> Equipe</NavLink>
                    <NavLink class="nav-link" href="/alunos" @onclick="CloseMenu"><Icon Name="cap" /> Alunos</NavLink>
                    <NavLink class="nav-link" href="/matriculas" @onclick="CloseMenu"><Icon Name="clipboard" /> Matrículas</NavLink>
                </div>
                <div class="nav-group">
                    <span>Avaliação</span>
                    <NavLink class="nav-link" href="/notas" @onclick="CloseMenu"><Icon Name="pen" /> Notas</NavLink>
                    <NavLink class="nav-link" href="/avaliacoes" @onclick="CloseMenu"><Icon Name="clipboard" /> Avaliações</NavLink>
                    <NavLink class="nav-link" href="/banco-questoes" @onclick="CloseMenu"><Icon Name="sparkles" /> Banco de questões</NavLink>
                    <NavLink class="nav-link" href="/praticar" @onclick="CloseMenu"><Icon Name="zap" /> Ver como aluno</NavLink>
                </div>
            }
            else if (Session.IsProfessor)
            {
                <div class="nav-group">
                    <span>Docência</span>
                    <NavLink class="nav-link" href="/professor" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Meu painel</NavLink>
                    <NavLink class="nav-link" href="/notas" @onclick="CloseMenu"><Icon Name="pen" /> Lançar notas</NavLink>
                    <NavLink class="nav-link" href="/alunos" @onclick="CloseMenu"><Icon Name="cap" /> Alunos</NavLink>
                </div>
                <div class="nav-group">
                    <span>Avaliações</span>
                    <NavLink class="nav-link" href="/avaliacoes" @onclick="CloseMenu"><Icon Name="clipboard" /> Provas e simulados</NavLink>
                    <NavLink class="nav-link" href="/banco-questoes" @onclick="CloseMenu"><Icon Name="sparkles" /> Banco de questões</NavLink>
                    <NavLink class="nav-link" href="/praticar" @onclick="CloseMenu"><Icon Name="zap" /> Ver como aluno</NavLink>
                </div>
            }
            else if (Session.User?.Role == UserRole.Aluno)
            {
                <div class="nav-group">
                    <span>Estudante</span>
                    <NavLink class="nav-link" href="/aluno" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Meu painel</NavLink>
                    <NavLink class="nav-link" href="/aluno/notas" @onclick="CloseMenu"><Icon Name="chart" /> Minhas notas</NavLink>
                    <NavLink class="nav-link" href="/praticar" @onclick="CloseMenu"><Icon Name="zap" /> Praticar questões</NavLink>
                </div>
            }
            else
            {
                <div class="nav-group">
                    <span>Conta</span>
                    <NavLink class="nav-link" href="/aguardando" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="clock" /> Status do acesso</NavLink>
                </div>
            }

            <div class="nav-group">
                <span>Minha área</span>
                <NavLink class="nav-link" href="/conta" @onclick="CloseMenu"><Icon Name="user-circle" /> Minha conta</NavLink>
            </div>

            <div class="sidebar-foot">
                <div class="who">
                    <AvatarImage UserId="Session.User!.Id" Name="@Session.User.Name" Stamp="Session.AvatarStamp" />
                    <div>
                        <strong>@Session.User?.Name</strong>
                        <small>@(Session.User is null ? "" : UiFormat.RoleLabel(Session.User.Role))</small>
                    </div>
                </div>
                <form method="post" action="/ui/logout">
                    <button type="submit" class="signout"><Icon Name="logout" Size="18" /> Sair da conta</button>
                </form>
            </div>
        }
    </aside>
    <label for="menu-toggle" class="menu-scrim" aria-label="Fechar menu"></label>

    <div class="main">
        <header class="topbar">
            <div style="display:flex;align-items:center;gap:14px">
                <label for="menu-toggle" class="menu-burger" aria-label="Abrir menu"><Icon Name="menu" Size="22" /></label>
                <div class="hello">
                    @UiFormat.LongDate(DateTime.Now)
                    <b>@UiTheme.Greeting(Session.User?.Role, UiFormat.FirstName(Session.User?.Name))</b>
                </div>
            </div>
            <div class="topbar-right">
                @if (Session.User is not null)
                {
                    @* NOVO: só o Admin vê este seletor: ele pode "ver como" qualquer prédio para conferir o tema. *@
                    @if (Session.User.Role == UserRole.Admin && Session.AllUnits.Count > 0)
                    {
                        <select class="unit-switch" aria-label="Ver como prédio ou curso" @onchange="OnThemeUnit">
                            <option value="" selected="@(Session.ThemeChoice == "")">Visão da rede</option>
                            @foreach (var u in Session.AllUnits)
                            {
                                <option value="unit:@u.Id" selected="@(Session.ThemeChoice == "unit:" + u.Id)">@u.Name</option>
                            }
                            <option value="course:medicina" selected="@Session.ThemeOverrideCourse">Perfil: Curso de Medicina</option>
                        </select>
                    }
                    <span class="badge-role role-chip">
                        <Icon Name="@UiTheme.RoleIcon(Session.User.Role)" Size="14" />
                        @UiFormat.RoleLabel(Session.User.Role)@(string.IsNullOrEmpty(Session.ThemeShort) ? "" : " · " + Session.ThemeShort)
                    </span>
                    <a href="/conta" aria-label="Minha conta"><AvatarImage UserId="Session.User.Id" Name="@Session.User.Name" Class="sm" Stamp="Session.AvatarStamp" /></a>
                }
            </div>
        </header>
        <div class="page">@Body</div>
        <footer class="page-foot">Faculdade Luciano Feijão@(Session.ThemeKey == "rede" ? "" : " · " + Session.ThemeLabel) · EduAssess</footer>
    </div>
</div>

@code {
    private bool menuOpen;
    private string homePath = "/painel";

    protected override async Task OnInitializedAsync()
    {
        // Quando a foto de perfil muda (tela "Minha conta"), redesenha o menu e o topo na hora.
        Session.Changed += OnSessionChanged;
        await Session.InitializeAsync();
        if (Session.User is not null)
            homePath = UiFormat.HomePath(Session.User.Role);
    }

    private void OnMenuChanged(ChangeEventArgs e) => menuOpen = e.Value is true;

    private void CloseMenu() => menuOpen = false;

    // NOVO: o Admin escolhe "ver como" um prédio ou o perfil do curso de Medicina; o tema muda na hora.
    private void OnThemeUnit(ChangeEventArgs e) => Session.SetThemeChoice(e.Value?.ToString());

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
