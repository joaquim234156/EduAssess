@page "/alunos"
@layout AppLayout
@attribute [Authorize(Policy = "AtribuirAluno")]
@inject UiSession Session
@inject AcademicService Academic
@inject AccountRegistrationService Accounts

<PageTitle>Alunos | EduAssess</PageTitle>

<PageHeader Eyebrow="Pessoas" Title="Alunos" Subtitle="Contas recém-criadas ficam aguardando um perfil. Atribua o perfil de aluno para liberar o acesso." />

<Feedback Message="@message" IsError="@isError" />

<div class="stack">
    <div class="card">
        <div class="card-head"><div><h2>Aguardando perfil</h2><p>Pessoas que criaram conta e ainda não têm acesso acadêmico.</p></div><span class="count-pill">@(pending?.Count ?? 0)</span></div>
        @if (pending is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (pending.Count == 0)
        {
            <EmptyState IconName="check-circle" Title="Tudo em dia" Text="Não há contas aguardando atribuição de perfil." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var person in pending)
                        {
                            <tr>
                                <td><div class="person"><div class="avatar sm">@UiFormat.Initials(person.Name)</div><strong>@person.Name</strong></div></td>
                                <td>@person.Email</td>
                                <td>@person.Phone</td>
                                <td><div class="row-actions"><button class="btn btn-primary btn-sm" type="button" @onclick="() => AssignAsync(person)"><Icon Name="cap" Size="16" /> Atribuir como aluno</button></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-head"><div><h2>Alunos ativos</h2><p>Estudantes com perfil de aluno.</p></div><span class="count-pill">@(students?.Count ?? 0)</span></div>
        @if (students is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (students.Count == 0)
        {
            <EmptyState IconName="cap" Title="Nenhum aluno ainda" Text="Atribua o perfil de aluno a uma conta pendente." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th></tr></thead>
                    <tbody>
                        @foreach (var person in students)
                        {
                            <tr>
                                <td><div class="person"><div class="avatar sm">@UiFormat.Initials(person.Name)</div><strong>@person.Name</strong></div></td>
                                <td>@person.Email</td>
                                <td>@person.Phone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<PersonRow>? pending;
    private List<PersonRow>? students;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var actor = await Session.RequireAsync(UserRole.Admin, UserRole.Gestor, UserRole.Professor);
            pending = await Accounts.GetPendingStudentAssignmentsAsync(actor.Role);
            students = await Academic.GetStudentsAsync();
        }
        catch (UnauthorizedAccessException ex) { message = ex.Message; isError = true; pending ??= new(); students ??= new(); }
    }

    private async Task AssignAsync(PersonRow person)
    {
        try
        {
            var actor = await Session.RequireAsync(UserRole.Admin, UserRole.Gestor, UserRole.Professor);
            await Accounts.AssignAsStudentAsync(actor.Role, person.Id);
            message = $"{person.Name} agora é aluno."; isError = false;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is KeyNotFoundException or UnauthorizedAccessException or InvalidOperationException)
        {
            message = ex.Message; isError = true;
        }
    }
}
