@page "/alunos"
@inject UiSession Session
@inject AcademicDashboardService Academic
@inject AccountRegistrationService Accounts
@inject NavigationManager Navigation

<PageTitle>Alunos | EduAssess</PageTitle>
<div class="page-heading"><div><div class="eyebrow">COMUNIDADE ACADÊMICA</div><h1>Alunos</h1><p>Consulte e atribua o perfil de aluno às contas cadastradas.</p></div></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @alertClass">@message</div> }
<div class="page-columns">
    @if (Session.CanAssignStudents)
    {
        <section class="panel form-panel">
            <div class="panel-heading"><div><h2>Contas para atribuir</h2><p>Admin, Gestor ou Professor pode atribuir o perfil de aluno.</p></div><span class="count-pill">@pendingUsers.Count</span></div>
            @if (pendingUsers.Count == 0)
            {
                <div class="empty-state"><strong>Nenhuma conta pendente</strong><span>As novas contas aparecerão aqui após o cadastro.</span></div>
            }
            else
            {
                <div class="table-wrap"><table><thead><tr><th>CONTA</th><th>E-MAIL</th><th></th></tr></thead><tbody>
                    @foreach (var user in pendingUsers)
                    {
                        <tr>
                            <td><strong>@user.Name</strong></td>
                            <td>@user.Email</td>
                            <td><button class="button button-primary" type="button" disabled="@busy" @onclick="() => AssignAsStudentAsync(user.Id)">Atribuir como aluno</button></td>
                        </tr>
                    }
                </tbody></table></div>
            }
        </section>
    }
    <section class="panel list-panel">
        <div class="panel-heading"><div><h2>Estudantes</h2><p>Alunos ativos na plataforma</p></div><span class="count-pill">@students.Count</span></div>
        @if (students.Count == 0) { <div class="empty-state"><div class="empty-icon">♙</div><strong>Nenhum aluno cadastrado</strong><span>As contas atribuídas aparecerão aqui.</span></div> }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>ALUNO</th><th>E-MAIL</th><th>TELEFONE</th></tr></thead><tbody>
                @foreach (var student in students)
                {
                    <tr><td><div class="table-person"><span class="avatar avatar-small">@GetInitials(student.Name)</span><strong>@student.Name</strong></div></td><td>@student.Email</td><td>@student.Phone</td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    private List<PersonRow> students = [];
    private List<PersonRow> pendingUsers = [];
    private string? message;
    private string alertClass = "alert-success";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanAssignStudents) { Navigation.NavigateTo("/login"); return; }
        await LoadAsync();
    }

private async Task LoadAsync()
{
    students = await Academic.GetStudentsAsync();
    pendingUsers = await Accounts.GetPendingStudentAssignmentsAsync(Session.User!.Role);
}

    private async Task AssignAsStudentAsync(Guid userId)
    {
        busy = true;
        try
        {
            await Accounts.AssignAsStudentAsync(Session.User!.Role, userId);
            message = "Perfil de aluno atribuído com sucesso.";
            alertClass = "alert-success";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or KeyNotFoundException or InvalidOperationException)
        { message = ex.Message; alertClass = "alert-error"; }
        finally
        {
            busy = false;
        }
    }

    private static string GetInitials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
