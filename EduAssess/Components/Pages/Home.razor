@page "/"
@inject ContactService Contacts

<PageTitle>EduAssess — Gestão acadêmica que transforma dados em decisões</PageTitle>

<section class="hero" id="top">
    <div class="container">
        <div>
            <span class="pill"><i><Icon Name="check" Size="14" StrokeWidth="3" /></i> Sua instituição tem direito a enxergar tudo com clareza</span>
            <h1>Transformamos a rotina acadêmica em <span class="mark">clareza.</span></h1>
            <p class="lead">Cursos, disciplinas, turmas, matrículas e notas conectados em uma única plataforma — para que coordenação, docentes e estudantes decidam com dados, não com palpites.</p>
            <div class="hero-actions">
                <a class="btn btn-accent btn-lg" href="#contato">Fale com a gente <Icon Name="arrow-up-right" Size="18" /></a>
                <a class="btn btn-ghost btn-lg" href="#solucao">Descubra como funciona <Icon Name="arrow-down" Size="18" /></a>
            </div>
            <div class="hero-proof">
                <div><strong>4</strong>perfis de acesso<br />hierárquicos</div>
                <div><strong>1</strong>base única para<br />toda a instituição</div>
                <div><strong>100%</strong>das ações validadas<br />no servidor</div>
            </div>
        </div>

        <aside class="preview" aria-label="Prévia do painel de gestão">
            <div class="preview-top">
                <small>Visão institucional</small>
                <span class="live">Prévia ilustrativa</span>
            </div>
            <h3>Comparativo de desempenho por curso</h3>
            <div class="preview-kpi">
                <strong>7,4</strong>
                <span>média institucional</span>
                <em>↗ 0,6 pt</em>
            </div>
            <div class="bars">
                <div class="bar-row"><div class="meta"><span>Enfermagem</span><b>8,3</b></div><div class="bar-track"><div class="bar-fill" style="width:83%"></div></div></div>
                <div class="bar-row"><div class="meta"><span>Direito</span><b>7,8</b></div><div class="bar-track"><div class="bar-fill" style="width:78%"></div></div></div>
                <div class="bar-row"><div class="meta"><span>Administração</span><b>7,1</b></div><div class="bar-track"><div class="bar-fill warn" style="width:71%"></div></div></div>
                <div class="bar-row"><div class="meta"><span>Pedagogia</span><b>6,4</b></div><div class="bar-track"><div class="bar-fill low" style="width:64%"></div></div></div>
            </div>
            <div class="preview-foot">
                <div>Cursos<b>4 avaliados</b></div>
                <div>Meta<b>7,0 de média</b></div>
                <div>Prioridade<b>Pedagogia</b></div>
            </div>
            <p class="preview-note">Dados fictícios, apenas para demonstração.</p>
        </aside>
    </div>
</section>

<section class="audience" aria-label="Para quem é">
    <div class="container">
        <p>Feita para quem organiza a educação.</p>
        <ul>
            <li><Icon Name="building" Size="18" /> Reitoria e direção</li>
            <li><Icon Name="compass" Size="18" /> Coordenação de curso</li>
            <li><Icon Name="pen" Size="18" /> Docentes</li>
            <li><Icon Name="clipboard" Size="18" /> Secretaria acadêmica</li>
            <li><Icon Name="cap" Size="18" /> Estudantes</li>
        </ul>
    </div>
</section>

<section class="section" id="desafio">
    <div class="container">
        <div class="eyebrow">01 — O desafio</div>
        <h2 class="section-title wide">A rotina acadêmica ainda é um <span class="mark mark-coral">ponto cego?</span></h2>
        <p class="section-lead">Quando a instituição não enxerga o que os dados dizem, cada decisão vira um palpite.</p>
        <div class="pains">
            <div class="pain"><div class="n">01</div><p>Cadastros de cursos e turmas espalhados em planilhas que ninguém sabe qual é a versão certa.</p></div>
            <div class="pain"><div class="n">02</div><p>Notas que chegam tarde demais para a coordenação conseguir agir antes do fim do período.</p></div>
            <div class="pain"><div class="n">03</div><p>Cada pessoa vendo um pedaço da história, sem uma visão integrada de cursos, turmas e alunos.</p></div>
        </div>
    </div>
</section>

<section class="section answer" id="solucao">
    <div class="container">
        <div>
            <div class="eyebrow">02 — A resposta</div>
            <h2>Uma nova forma de olhar para a <span class="mark">gestão acadêmica.</span></h2>
            <p>Do cadastro do curso ao boletim do aluno, o EduAssess conecta todos os pontos para que a instituição avance com intenção — cada perfil enxerga exatamente o que precisa.</p>
            <a class="link-arrow" href="#recursos">Explore a plataforma <Icon Name="arrow-up-right" Size="18" /></a>
        </div>
        <div class="orbit" aria-hidden="true">
            <div class="ring"></div><div class="ring r2"></div>
            <div class="core">dados<br />→ ação</div>
            <span class="node n1">clareza</span><span class="node n2">impacto</span><span class="node n3">controle</span><span class="node n4">confiança</span>
        </div>
    </div>
</section>

<section class="section" id="recursos">
    <div class="container">
        <div class="eyebrow">03 — Tudo conectado</div>
        <h2 class="section-title wide">Gerir é só <span class="mark">o começo.</span></h2>
        <p class="section-lead">Da estrutura do curso à decisão pedagógica, quatro frentes trabalham juntas para estudantes, docentes, coordenações e instituições.</p>

        <div class="modules">
            <article class="module">
                <span class="ghost-n">01</span>
                <div class="tag"><b>01</b> EduAssess Estrutura</div>
                <h3>Organize.</h3>
                <p>Monte o catálogo acadêmico com poucos cliques e mantenha tudo sempre atualizado.</p>
                <ul>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Cursos com duração e descrição</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Disciplinas vinculadas a professores</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Turmas por curso e período</li>
                </ul>
            </article>
            <article class="module">
                <span class="ghost-n">02</span>
                <div class="tag"><b>02</b> EduAssess Pessoas</div>
                <h3>Conecte.</h3>
                <p>Contas, perfis e matrículas respeitando a hierarquia de cada instituição.</p>
                <ul>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Administrador, gestor, professor e aluno</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Cadastro público com atribuição de perfil</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Matrículas ligadas às turmas</li>
                </ul>
            </article>
            <article class="module">
                <span class="ghost-n">03</span>
                <div class="tag"><b>03</b> EduAssess Avaliações</div>
                <h3>Avalie.</h3>
                <p>Notas lançadas na hora, por disciplina, com histórico e rastreio de quem lançou.</p>
                <ul>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Lançamento por matrícula e disciplina</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Professor só avalia as próprias turmas</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Boletim individual para o aluno</li>
                </ul>
            </article>
            <article class="module">
                <span class="ghost-n">04</span>
                <div class="tag"><b>04</b> EduAssess Painéis</div>
                <h3>Decida.</h3>
                <p>Indicadores que mostram onde agir primeiro, do curso à instituição.</p>
                <ul>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Média por curso e média geral</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Matrículas recentes e contas pendentes</li>
                    <li><Icon Name="check" Size="14" StrokeWidth="3" /> Painéis próprios para professor e aluno</li>
                </ul>
            </article>
        </div>

        <div class="flow" aria-label="Fluxo da plataforma">
            <span>Estruturar</span><Icon Name="arrow-right" Size="18" />
            <span>Matricular</span><Icon Name="arrow-right" Size="18" />
            <span>Avaliar</span><Icon Name="arrow-right" Size="18" />
            <span>Decidir</span>
        </div>
        <p class="flow-note">Uma plataforma integrada, simples de usar e orientada por evidências.</p>
    </div>
</section>

<section class="section why" id="dados">
    <div class="container">
        <div class="why-head">
            <div>
                <div class="eyebrow">04 — Por que o EduAssess</div>
                <h2 class="section-title">A diferença está em <span class="mark">enxergar melhor</span> o que a rotina revela.</h2>
            </div>
            <p class="section-lead">Método, tecnologia e segurança conectam cada etapa — do cadastro do curso à intervenção pedagógica.</p>
        </div>
        <div class="pillars">
            <div class="pillar"><div class="n">01</div><h3>Clareza de papéis.</h3><p>Hierarquia explícita: o administrador cria gestores, o gestor cria professores e cada ação é checada no servidor.</p></div>
            <div class="pillar"><div class="n">02</div><h3>Tecnologia a serviço.</h3><p>Painéis em tempo real e fluxos curtos tiram o trabalho braçal da secretaria e devolvem tempo à docência.</p></div>
            <div class="pillar"><div class="n">03</div><h3>Decisões que se sustentam.</h3><p>Dados organizados mostram onde agir, acompanham a evolução e orientam o próximo passo.</p></div>
        </div>
    </div>
</section>

<section class="quote-band">
    <div class="container">
        <blockquote>Quando a gestão deixa de ser burocracia, ela vira <em>o começo</em> de uma transformação.</blockquote>
        <cite>— EduAssess</cite>
        <div class="stats">
            <div><strong>4</strong><span>perfis de acesso com permissões próprias</span></div>
            <div><strong>6</strong><span>módulos integrados: cursos, disciplinas, turmas, pessoas, matrículas e notas</span></div>
            <div><strong>2</strong><span>camadas de acesso: painel web e API documentada</span></div>
            <div><strong>0</strong><span>planilhas paralelas para manter</span></div>
        </div>
    </div>
</section>

<section class="section contact" id="contato">
    <div class="container">
        <div>
            <div class="eyebrow">05 — Vamos conversar</div>
            <h2>O próximo passo <span class="mark">começa aqui.</span></h2>
            <p class="lead">Conte para a gente o desafio da sua instituição. Nossa equipe entra em contato para encontrar o melhor caminho.</p>
            <ul class="contact-points">
                <li><span class="ico"><Icon Name="mail" Size="20" /></span> Resposta personalizada para a sua instituição</li>
                <li><span class="ico"><Icon Name="shield" Size="20" /></span> Seus dados são usados apenas para este contato</li>
                <li><span class="ico"><Icon Name="clock" Size="20" /></span> Retorno em até 2 dias úteis</li>
            </ul>
        </div>
        <div class="form-card">
            <h3>Vamos entender o seu desafio</h3>
            <p class="sub">Conte um pouco sobre a sua instituição.</p>

            @if (sent)
            {
                <div class="alert alert-success" role="status"><Icon Name="check-circle" Size="18" /><span>Solicitação enviada! Obrigado, entraremos em contato em breve.</span></div>
                <button class="btn btn-ghost btn-block" type="button" @onclick="NewRequest">Enviar outra solicitação</button>
            }
            else
            {
                <Feedback Message="@error" IsError="true" />
                <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="contato">
                    <DataAnnotationsValidator />
                    <div class="field"><label for="c-name">Nome completo</label><InputText id="c-name" class="input" @bind-Value="form.Name" autocomplete="name" /><ValidationMessage For="@(() => form.Name)" /></div>
                    <div class="form-row">
                        <div class="field"><label for="c-email">E-mail institucional</label><InputText id="c-email" class="input" @bind-Value="form.Email" autocomplete="email" /><ValidationMessage For="@(() => form.Email)" /></div>
                        <div class="field"><label for="c-phone">Telefone / WhatsApp <span class="opt">(opcional)</span></label><InputText id="c-phone" class="input" @bind-Value="form.Phone" autocomplete="tel" /></div>
                    </div>
                    <div class="form-row">
                        <div class="field"><label for="c-inst">Instituição</label><InputText id="c-inst" class="input" @bind-Value="form.Institution" /><ValidationMessage For="@(() => form.Institution)" /></div>
                        <div class="field"><label for="c-role">Seu papel</label>
                            <InputSelect id="c-role" class="select" @bind-Value="form.Role">
                                <option value="">Selecione</option>
                                @foreach (var role in ContactService.Roles) { <option value="@role">@role</option> }
                            </InputSelect>
                            <ValidationMessage For="@(() => form.Role)" />
                        </div>
                    </div>
                    <div class="field"><label for="c-msg">Como podemos ajudar? <span class="opt">(opcional)</span></label><InputTextArea id="c-msg" class="textarea" @bind-Value="form.Message" /></div>
                    <button class="btn btn-primary btn-lg btn-block" type="submit" disabled="@busy">@(busy ? "Enviando…" : "Enviar solicitação") <Icon Name="arrow-up-right" Size="18" /></button>
                    <p class="form-fine">Ao enviar, você concorda que o EduAssess entre em contato sobre esta solicitação.</p>
                </EditForm>
            }
        </div>
    </div>
</section>

<section class="section section-tight">
    <div class="container">
        <div class="section-head-row">
            <div>
                <div class="eyebrow">Conteúdos</div>
                <h2 class="section-title wide">Ideias que ajudam a educação <span class="mark">a avançar.</span></h2>
            </div>
            <a class="link-arrow" href="/conteudos">Ver todos os conteúdos <Icon Name="arrow-up-right" Size="18" /></a>
        </div>
        <div class="articles">
            @foreach (var article in Articles.All)
            {
                <a class="article-card" href="/conteudos#@article.Slug">
                    <span class="kicker">@article.Kicker</span>
                    <h3>@article.Title</h3>
                    <p>@article.Summary</p>
                    <span class="link-arrow">Ler artigo <Icon Name="arrow-up-right" Size="16" /></span>
                </a>
            }
        </div>
    </div>
</section>

@code {
    private readonly ContactForm form = new();
    private bool busy;
    private bool sent;
    private string? error;

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Contacts.SubmitAsync(form.Name, form.Email, form.Phone, form.Institution, form.Role, form.Message);
            sent = true;
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void NewRequest()
    {
        form.Name = form.Email = form.Phone = form.Institution = form.Role = form.Message = "";
        sent = false;
    }

    private sealed class ContactForm
    {
        [Required(ErrorMessage = "Informe seu nome completo.")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Use entre 3 e 100 caracteres.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = "";

        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "Informe a instituição.")]
        public string Institution { get; set; } = "";

        [Required(ErrorMessage = "Selecione o seu papel.")]
        public string Role { get; set; } = "";

        [StringLength(1000, ErrorMessage = "Use até 1000 caracteres.")]
        public string Message { get; set; } = "";
    }
}
