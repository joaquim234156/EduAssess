@page "/cadastro"
@layout AuthLayout
@inject AccountRegistrationService Accounts

<PageTitle>Criar conta | EduAssess</PageTitle>

<div class="auth">
    <aside class="auth-aside">
        <Logo Light="true" />
        <div>
            <div class="eyebrow">Seu primeiro passo</div>
            <h1>Crie sua conta no <span class="mark">EduAssess.</span></h1>
            <p>Depois do cadastro, um administrador, gestor ou professor atribui o seu perfil acadêmico e libera o seu painel.</p>
            <ul class="auth-points">
                <li><Icon Name="check-circle" Size="20" /> Cadastro em menos de um minuto</li>
                <li><Icon Name="check-circle" Size="20" /> Conta sem privilégios até a atribuição do perfil</li>
                <li><Icon Name="check-circle" Size="20" /> Seus dados protegidos com criptografia</li>
            </ul>
        </div>
        <div class="auth-foot">EDUASSESS · PLATAFORMA EDUCACIONAL</div>
    </aside>

    <section class="auth-main">
        <div class="auth-card">
            <a class="back" href="/"><Icon Name="arrow-left" Size="16" /> Voltar ao site</a>
            <div class="eyebrow">Novo cadastro</div>
            <h2>Criar uma conta</h2>
            <p class="sub">Preencha seus dados para começar.</p>

            @if (created)
            {
                <div class="alert alert-success" role="status"><Icon Name="check-circle" Size="18" /><span>Conta criada! Aguarde um administrador, gestor ou professor atribuir o seu perfil de aluno.</span></div>
                <a class="btn btn-primary btn-lg btn-block" href="/login">Ir para o login <Icon Name="arrow-right" Size="18" /></a>
            }
            else
            {
                <Feedback Message="@error" IsError="true" />
                <EditForm Model="form" OnValidSubmit="RegisterAsync" FormName="cadastro">
                    <DataAnnotationsValidator />
                    <div class="field"><label for="r-name">Nome completo</label><InputText id="r-name" class="input" @bind-Value="form.Name" autocomplete="name" /><ValidationMessage For="@(() => form.Name)" /></div>
                    <div class="field"><label for="r-email">E-mail</label><InputText id="r-email" class="input" @bind-Value="form.Email" autocomplete="email" /><ValidationMessage For="@(() => form.Email)" /></div>
                    <div class="form-row">
                        <div class="field"><label for="r-cpf">CPF</label><InputText id="r-cpf" class="input" @bind-Value="form.Cpf" inputmode="numeric" placeholder="000.000.000-00" /><ValidationMessage For="@(() => form.Cpf)" /></div>
                        <div class="field"><label for="r-phone">Telefone</label><InputText id="r-phone" class="input" @bind-Value="form.Phone" inputmode="numeric" autocomplete="tel" placeholder="(11) 90000-0000" /><ValidationMessage For="@(() => form.Phone)" /></div>
                    </div>
                    <div class="field"><label for="r-birth">Data de nascimento</label><InputDate id="r-birth" class="input" @bind-Value="form.BirthDate" /><ValidationMessage For="@(() => form.BirthDate)" /></div>
                    <div class="form-row">
                        <div class="field"><label for="r-pass">Senha</label><InputText id="r-pass" type="password" class="input" @bind-Value="form.Password" autocomplete="new-password" /><ValidationMessage For="@(() => form.Password)" /></div>
                        <div class="field"><label for="r-pass2">Confirmar senha</label><InputText id="r-pass2" type="password" class="input" @bind-Value="form.ConfirmPassword" autocomplete="new-password" /><ValidationMessage For="@(() => form.ConfirmPassword)" /></div>
                    </div>
                    <button class="btn btn-primary btn-lg btn-block" type="submit" disabled="@busy">@(busy ? "Criando conta…" : "Criar conta") <Icon Name="arrow-right" Size="18" /></button>
                </EditForm>
                <p class="auth-switch">Já tem uma conta? <a href="/login">Entrar</a></p>
            }
        </div>
    </section>
</div>

@code {
    private readonly AccountRegistrationForm form = new();
    private string? error;
    private bool busy;
    private bool created;

    private async Task RegisterAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Accounts.RegisterUserAsync(
                form.Name, form.Email, form.Cpf, form.Phone, form.BirthDate,
                form.Password, form.ConfirmPassword);
            created = true;
        }
        catch (Exception ex) when (ex is AccountConflictException or ArgumentException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
