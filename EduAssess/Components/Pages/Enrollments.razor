@page "/matriculas"
@inject UiSession Session
@inject AcademicDashboardService Academic
@inject NavigationManager Navigation

<PageTitle>Matrículas | EduAssess</PageTitle>
<div class="page-heading"><div><div class="eyebrow">VÍNCULOS ACADÊMICOS</div><h1>Matrículas</h1><p>Acompanhe os alunos vinculados às turmas.</p></div></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @alertClass">@message</div> }
<div class="page-columns">
    @if (Session.CanManage)
    {
        <section class="panel form-panel">
            <div class="panel-heading"><div><h2>Nova matrícula</h2><p>Vincule um aluno a uma turma ativa.</p></div></div>
            <EditForm Model="form" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <label class="field-label">Aluno</label><InputSelect class="text-input" @bind-Value="form.StudentId"><option value="">Selecione um aluno</option>@foreach (var student in students) { <option value="@student.Id">@student.Name</option> }</InputSelect><ValidationMessage For="@(() => form.StudentId)" />
                <label class="field-label">Turma</label><InputSelect class="text-input" @bind-Value="form.ClassId"><option value="">Selecione uma turma</option>@foreach (var item in classes) { <option value="@item.Id">@item.Name — @item.CourseName</option> }</InputSelect><ValidationMessage For="@(() => form.ClassId)" />
                <button class="button button-primary full-button" type="submit">Registrar matrícula</button>
            </EditForm>
        </section>
    }
    <section class="panel list-panel">
        <div class="panel-heading"><div><h2>Todas as matrículas</h2><p>Histórico acadêmico dos estudantes</p></div><span class="count-pill">@enrollments.Count</span></div>
        @if (enrollments.Count == 0) { <div class="empty-state"><div class="empty-icon">▣</div><strong>Nenhuma matrícula registrada</strong><span>As matrículas aparecerão aqui.</span></div> }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>ALUNO</th><th>CURSO / TURMA</th><th>DATA</th><th>STATUS</th></tr></thead><tbody>
                @foreach (var item in enrollments)
                {
                    <tr><td><div class="table-person"><span class="avatar avatar-small">@GetInitials(item.StudentName)</span><strong>@item.StudentName</strong></div></td><td><span class="cell-primary">@item.CourseName</span><span class="cell-secondary">@item.ClassName</span></td><td>@item.EnrolledAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td><span class="badge @(item.Active ? "badge-green" : "badge-gray")">@(item.Active ? "Ativa" : "Inativa")</span></td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    private List<EnrollmentRow> enrollments = [];
    private List<PersonRow> students = [];
    private List<ClassRow> classes = [];
    private EnrollmentForm form = new();
    private string? message;
    private string alertClass = "alert-success";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManage) { Navigation.NavigateTo(Session.IsStudent ? "/aluno" : Session.CanAssignStudents ? "/alunos" : "/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        enrollments = await Academic.GetEnrollmentsAsync();
        students = await Academic.GetStudentsAsync();
        classes = await Academic.GetClassesAsync();
    }

    private async Task CreateAsync()
    {
        try
        {
            if (form.StudentId == Guid.Empty || form.ClassId == Guid.Empty)
                throw new ArgumentException("Selecione um aluno e uma turma.");
            await Academic.CreateEnrollmentAsync(form.StudentId, form.ClassId);
            message = "Matrícula registrada com sucesso.";
            alertClass = "alert-success";
            form = new EnrollmentForm();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException)
        { message = ex.Message; alertClass = "alert-error"; }
    }

    private static string GetInitials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));

    private sealed class EnrollmentForm
    {
        [Required(ErrorMessage = "Selecione um aluno.")] public Guid StudentId { get; set; }
        [Required(ErrorMessage = "Selecione uma turma.")] public Guid ClassId { get; set; }
    }
}
