@page "/instituicao"
@layout AppLayout
@attribute [Authorize(Policy = "Gestao")]
@using global::EduAssess.Models.Global
@using global::EduAssess.Models.Local
@inject InstitutionWebService Institution
@inject UiSession Session
@inject NavigationManager Nav

@* NOVA TELA: instituição (Faculdade Luciano Feijão), unidades (prédios) e lotação das pessoas.
   Usa as mesmas regras da API /instituicoes, /unidades e /usuario-instituicao (InstitutionWebService).
   Cada cartão de unidade usa a própria paleta (classe unit-*), igual ao tema que a pessoa lotada ali enxerga. *@

<PageTitle>Unidades e pessoas | Faculdade Luciano Feijão</PageTitle>

<RoleHero Title="Instituição e unidades" Subtitle="Os prédios da instituição e quem está em cada um. O visual de cada pessoa vem do prédio; alunos e professores de Medicina têm o visual do curso.">
    @if (Session.User?.Role == UserRole.Admin)
    {
        <button type="button" class="btn btn-ghost" @onclick="OpenInstitutionCreate"><Icon Name="building" Size="18" /> Nova instituição</button>
    }
    @if (overview?.Institution is not null)
    {
        <button type="button" class="btn btn-primary" @onclick="OpenUnitCreate"><Icon Name="plus" Size="18" /> Nova unidade</button>
    }
</RoleHero>

<Feedback Message="@message" IsError="true" />

@if (overview is null)
{
    <div class="loading"><span class="spinner"></span> Carregando a instituição…</div>
}
else if (overview.Institution is null)
{
    <div class="card"><EmptyState IconName="building" Title="Nenhuma instituição cadastrada" Text="Reinicie o sistema para criar a instituição base ou cadastre uma em Nova instituição (Admin)." /></div>
}
else
{
    var inst = overview.Institution;

    @* ───────────── Instituição ───────────── *@
    <section class="inst-hero branded reveal" style="--brand-primary:@inst.Primary;--brand-secondary:@inst.Secondary">
        <div class="logo-box">
            @if (inst.HasLogo)
            {
                <img src="/ui/instituicao-logo/@inst.Id?v=@inst.LogoVersion" alt="@inst.Name" />
            }
            else if (inst.Tipo == TipoInstituicao.Faculdade && inst.Sigla == "FLF")
            {
                <img src="img/logo-flf.png" alt="@inst.Name" />
            }
            else
            {
                <span class="brand-mono big" style="background:@inst.Primary;color:@InkFor(inst.Primary)" aria-hidden="true">@(string.IsNullOrWhiteSpace(inst.Sigla) ? "—" : inst.Sigla)</span>
            }
        </div>
        <dl>
            <div><dt>Instituição</dt><dd>@inst.Name@(string.IsNullOrWhiteSpace(inst.Sigla) ? "" : " (" + inst.Sigla + ")")</dd></div>
            <div><dt>Categoria</dt><dd>@UiFormat.InstitutionTypeLabel(inst.Tipo)</dd></div>
            <div><dt>Mantenedor</dt><dd>@(string.IsNullOrWhiteSpace(inst.MantenedorName) ? "—" : inst.MantenedorName)</dd></div>
            <div><dt>Identidade visual</dt><dd class="swatches"><span class="swatch" style="background:@inst.Primary" title="Cor primária @inst.Primary"></span><span class="swatch" style="background:@inst.Secondary" title="Cor secundária @inst.Secondary"></span> @inst.Primary · @inst.Secondary</dd></div>
            <div><dt>CNPJ</dt><dd>@inst.Cnpj</dd></div>
            <div><dt>E-mail</dt><dd>@(string.IsNullOrWhiteSpace(inst.Email) ? "—" : inst.Email)</dd></div>
            <div><dt>Telefone</dt><dd>@(string.IsNullOrWhiteSpace(inst.Phone) ? "—" : inst.Phone)</dd></div>
            <div><dt>Endereço</dt><dd>@(string.IsNullOrWhiteSpace(inst.Address) ? "—" : inst.Address)</dd></div>
        </dl>
        <div class="inst-actions">
            <button type="button" class="btn btn-ghost" @onclick="OpenInstitutionEdit"><Icon Name="edit" Size="16" /> Editar dados</button>
            <button type="button" class="btn btn-ghost" @onclick="OpenBrand"><Icon Name="image" Size="16" /> Identidade visual</button>
        </div>
    </section>

    @* ───────────── NOVO: rede do mantenedor (ex.: Faculdade + Colégio CLF, cada um gerenciado à parte) ───────────── *@
    @if (overview.Network is { Count: > 0 })
    {
        <section class="card network-card reveal" style="margin-top:20px">
            <div class="card-head"><div><h2>Rede de @inst.MantenedorName</h2><p>Instituições do mesmo mantenedor. Cada uma tem seus próprios cadastros, unidades e pessoas; o vínculo com o mantenedor é mantido.</p></div></div>
            <div class="network-list">
                @foreach (var n in overview.Network)
                {
                    var canSwitch = !n.Current && n.Active && Session.AvailableInstitutions.Any(a => a.Id == n.Id);
                    <div class="network-item @(n.Current ? "current" : "")">
                        <div>
                            <strong>@n.Name@(string.IsNullOrWhiteSpace(n.Sigla) ? "" : " (" + n.Sigla + ")")</strong>
                            <small>@UiFormat.InstitutionTypeLabel(n.Tipo)@(n.Active ? "" : " · desativada")</small>
                        </div>
                        @if (n.Current) { <span class="badge badge-green">Em uso</span> }
                        else if (canSwitch)
                        {
                            <form method="post" action="/ui/instituicao/selecionar">
                                <input type="hidden" name="id" value="@n.Id" />
                                <input type="hidden" name="returnUrl" value="/instituicao" />
                                <button type="submit" class="btn btn-ghost btn-sm">Gerenciar</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @* ───────────── Unidades ───────────── *@
    <div class="sec-head"><h2>Unidades (prédios)</h2><small>@overview.Units.Count(u => u.Active) ativas</small></div>
    <div class="unit-grid">
        @{ var i = 0; }
        @foreach (var unit in overview.Units)
        {
            i++;
            var u = unit;
            var key = UiTheme.UnitKey(u.Slug);
            <article class="unit-card unit-@key @(u.Active ? "" : "off") reveal" style="--i:@i;@UiTheme.CustomStyle(u.Slug)">
                <div class="uc-head">
                    <span class="uc-ico">
                        @if (u.HasLogo) { <img class="unit-brand-thumb" src="/ui/unidade-logo/@u.Id?v=@u.LogoVersion" alt="" aria-hidden="true" /> }
                        else { <Icon Name="@UiTheme.UnitIcon(u.Slug)" Size="24" /> }
                    </span>
                    <h3>@u.Name</h3>
                    <div class="uc-sub">@u.Sigla · @TipoUnidadeLabel(u.Type)@(u.Active ? "" : " · desativada")</div>
                    <div class="uc-sub">@(u.Primary is null && u.Secondary is null && !u.HasLogo ? "Identidade visual herdada" : "Identidade visual própria")</div>
                </div>
                <div class="uc-body">
                    <div class="uc-counts">
                        <div><b>@u.Students</b><small>Alunos</small></div>
                        <div><b>@u.Professors</b><small>Professores</small></div>
                        <div><b>@u.Managers</b><small>Gestores</small></div>
                    </div>
                    <div class="uc-actions">
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => FilterUnit(u.Id)"><Icon Name="users" Size="16" /> Ver pessoas</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => OpenUnitEdit(u)"><Icon Name="edit" Size="16" /> Editar</button>
                        @if (Session.User?.Role == UserRole.Admin && u.Active)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" title="Ver o painel com as cores desta unidade" @onclick="() => PreviewTheme(u.Id)"><Icon Name="eye" Size="16" /> Ver tema</button>
                        }
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleUnit(u)">@(u.Active ? "Desativar" : "Reativar")</button>
                    </div>
                </div>
            </article>
        }
        @* NOVO: Medicina não é prédio. É o perfil de quem é do CURSO de Medicina (em qualquer prédio). *@
        <article class="unit-card unit-medicina reveal" style="--i:@(i + 1)">
            <div class="uc-head">
                <span class="uc-ico"><Icon Name="stethoscope" Size="24" /></span>
                <h3>Curso de Medicina</h3>
                <div class="uc-sub">Perfil por curso · MED</div>
            </div>
            <div class="uc-body">
                <div class="uc-counts" style="grid-template-columns:repeat(2,1fr)">
                    <div><b>@overview.MedicineStudents</b><small>Alunos</small></div>
                    <div><b>@overview.MedicineProfessors</b><small>Professores</small></div>
                </div>
                <p class="hint-line" style="margin:0"><Icon Name="sparkles" Size="16" /> Quem estuda ou leciona no curso de Medicina ganha este visual automaticamente, em qualquer prédio.</p>
                @if (Session.User?.Role == UserRole.Admin)
                {
                    <div class="uc-actions"><button type="button" class="btn btn-ghost btn-sm" @onclick='() => PreviewCourseTheme()'><Icon Name="eye" Size="16" /> Ver tema</button></div>
                }
            </div>
        </article>

        <button type="button" class="unit-card add unit-principal reveal" @onclick="OpenUnitCreate" aria-label="Nova unidade">
            <span><Icon Name="plus" Size="30" /> Nova unidade</span>
        </button>
    </div>

    @* ───────────── Pessoas e lotação ───────────── *@
    <section class="card reveal" style="margin-top:28px">
        <div class="card-head">
            <div><h2>Pessoas e lotação</h2><p>Escolha o prédio de cada pessoa. O painel dela muda de cores na próxima vez que ela entrar.</p></div>
            <span class="count-pill">@(people?.Count ?? 0)</span>
        </div>

        <div class="chips" role="group" aria-label="Filtrar por unidade">
            <button type="button" class="chip @(unitFilter is null && !showUnlinked ? "active" : "")" @onclick="() => FilterUnit(null)">Todas</button>
            @foreach (var unit in overview.Units.Where(x => x.Active))
            {
                var id = unit.Id;
                <button type="button" class="chip @(unitFilter == id && !showUnlinked ? "active" : "")" @onclick="() => FilterUnit(id)">@unit.Name <small>@unit.People</small></button>
            }
            <button type="button" class="chip @(unitFilter == Guid.Empty && !showUnlinked ? "active" : "")" @onclick="() => FilterUnit(Guid.Empty)">Sem unidade <small>@overview.PeopleWithoutUnit</small></button>
            <button type="button" class="chip @(showUnlinked ? "active" : "")" @onclick="FilterUnlinked">@(Session.User?.Role == UserRole.Admin ? "Não vinculadas" : "Sem vínculo institucional") <small>@overview.UnlinkedPeople</small></button>
        </div>

        <div class="people-bar">
            <label class="toolbar-search">
                <Icon Name="search" Size="16" />
                <input type="search" placeholder="Buscar por nome ou e-mail" value="@search" @oninput="OnSearch" aria-label="Buscar pessoas" />
            </label>
        </div>

        @if (people is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando pessoas…</div>
        }
        else if (people.Count == 0)
        {
            <EmptyState IconName="users" Title="Ninguém por aqui" Text="Nenhuma pessoa encontrada com esses filtros." />
        }
        else
        {
            @foreach (var person in people)
            {
                var p = person;
                <div class="person-row">
                    <AvatarImage UserId="p.UserId" Name="@p.Name" Class="sm" />
                    <div class="pr-name"><strong>@p.Name</strong><small>@p.Email</small></div>
                    <span class="badge badge-violet">@UiFormat.RoleLabel(p.Role)</span>
                    <select class="unit-select" aria-label="Unidade de @p.Name" @onchange="e => AssignAsync(p.UserId, e.Value?.ToString())">
                        <option value="" selected="@(p.UnitId is null)">Sem unidade</option>
                        @foreach (var unit in overview.Units.Where(x => x.Active || x.Id == p.UnitId))
                        {
                            <option value="@unit.Id" selected="@(p.UnitId == unit.Id)">@unit.Name</option>
                        }
                    </select>
                    @if (p.Linked)
                    {
                        <button type="button" class="btn-text danger" title="Tirar esta pessoa da instituição" @onclick="() => SetLinkAsync(p.UserId, false)">Desvincular</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-ghost btn-sm" title="Vincular a esta instituição" @onclick="() => SetLinkAsync(p.UserId, true)">Vincular</button>
                    }
                </div>
            }
        }
    </section>
}

@if (toast is not null)
{
    <div class="toast" role="status" @key="toastId">@toast</div>
}

@* ───────────── Janela: unidade ───────────── *@
<Modal Open="showUnit" Eyebrow="@(editingUnit is null ? "Nova unidade" : "Editar unidade")" Title="@(string.IsNullOrWhiteSpace(unitForm.Name) ? "Unidade" : unitForm.Name)" OnClose="CloseUnit">
    <ChildContent>
        <Feedback Message="@formMessage" IsError="true" />
        <div class="field">
            <label for="u-name">Nome</label>
            <input id="u-name" class="input" @bind="unitForm.Name" @bind:event="oninput" maxlength="60" placeholder="Ex.: Prédio Direito" />
        </div>
        <div class="form-row">
            <div class="field">
                <label for="u-sigla">Sigla</label>
                <input id="u-sigla" class="input" @bind="unitForm.Sigla" maxlength="10" placeholder="Ex.: DIR" />
            </div>
            <div class="field">
                <label>Tipo de unidade</label>
                <div class="seg">
                    <button type="button" class="@(unitForm.Type == TipoUnidade.Campus ? "on" : "")" @onclick="() => unitForm.Type = TipoUnidade.Campus">Campus</button>
                    <button type="button" class="@(unitForm.Type == TipoUnidade.Polo ? "on" : "")" @onclick="() => unitForm.Type = TipoUnidade.Polo">Polo</button>
                    <button type="button" class="@(unitForm.Type == TipoUnidade.Predio ? "on" : "")" @onclick="() => unitForm.Type = TipoUnidade.Predio">Prédio</button>
                </div>
            </div>
        </div>

        <div class="field">
            <label>Logotipo ou imagem da unidade</label>
            <div class="brand-logo-edit">
                <div class="logo-box">
                    @if (pendingUnitLogo is not null)
                    {
                        <span class="brand-mono big" aria-label="Novo arquivo selecionado">IMG</span>
                    }
                    else if (editingUnit?.HasLogo == true && !unitForm.RemoveLogo)
                    {
                        <img src="/ui/unidade-logo/@editingUnit.Id?v=@editingUnit.LogoVersion" alt="Logotipo atual da unidade" />
                    }
                    else if (overview?.Institution?.HasLogo == true)
                    {
                        <img src="/ui/instituicao-logo/@overview.Institution.Id?v=@overview.Institution.LogoVersion" alt="Logotipo herdado da instituição" />
                    }
                    else if (overview?.Institution is { Tipo: TipoInstituicao.Faculdade, Sigla: "FLF" })
                    {
                        <img src="/img/logo-flf.png" alt="Logotipo padrão da Faculdade Luciano Feijão" />
                    }
                    else
                    {
                        <span class="brand-mono big" style="background:@overview?.Institution?.Primary;color:@InkFor(overview?.Institution?.Primary ?? "#1F4E79")" aria-hidden="true">@(string.IsNullOrWhiteSpace(unitForm.Sigla) ? "—" : unitForm.Sigla)</span>
                    }
                </div>
                <div class="dropzone @(uploadingUnitLogo ? "busy" : "")">
                    <InputFile OnChange="OnUnitLogoSelected" accept="image/png,image/jpeg,image/webp,image/gif" aria-label="Escolher logotipo da unidade" />
                    @if (uploadingUnitLogo) { <span class="spinner"></span><strong>Salvando…</strong> }
                    else if (pendingUnitLogo is not null) { <span class="dz-ico"><Icon Name="check" Size="22" /></span><strong>@pendingUnitLogo.Name</strong><small>O arquivo será enviado ao salvar a unidade.</small> }
                    else { <span class="dz-ico"><Icon Name="upload" Size="22" /></span><strong>Clique ou arraste uma imagem</strong><small>PNG, JPG, WebP ou GIF até 8 MB. A transparência é preservada.</small> }
                </div>
            </div>
            @if (editingUnit?.HasLogo == true && !unitForm.RemoveLogo)
            {
                <button type="button" class="btn-text danger" @onclick="RemoveUnitLogo"><Icon Name="trash" Size="16" /> Usar logotipo da instituição</button>
            }
            @if (unitForm.RemoveLogo)
            {
                <small class="muted">A unidade passará a herdar o logotipo da instituição.</small>
            }
        </div>

        <div class="form-row">
            <div class="field">
                <label for="u-primary">Cor primária</label>
                <label class="brand-inherit"><input type="checkbox" @bind="unitForm.InheritPrimary" /> Herdar da instituição</label>
                <div class="color-field">
                    <input id="u-primary" type="color" value="@unitForm.Primary" disabled="@unitForm.InheritPrimary" @onchange="e => unitForm.Primary = NormalizeHex(e.Value, unitForm.Primary)" />
                    <input class="input" value="@unitForm.Primary" maxlength="7" disabled="@unitForm.InheritPrimary" aria-label="Código da cor primária da unidade" @onchange="e => unitForm.Primary = NormalizeHex(e.Value, unitForm.Primary)" />
                </div>
            </div>
            <div class="field">
                <label for="u-secondary">Cor secundária</label>
                <label class="brand-inherit"><input type="checkbox" @bind="unitForm.InheritSecondary" /> Herdar da instituição</label>
                <div class="color-field">
                    <input id="u-secondary" type="color" value="@unitForm.Secondary" disabled="@unitForm.InheritSecondary" @onchange="e => unitForm.Secondary = NormalizeHex(e.Value, unitForm.Secondary)" />
                    <input class="input" value="@unitForm.Secondary" maxlength="7" disabled="@unitForm.InheritSecondary" aria-label="Código da cor secundária da unidade" @onchange="e => unitForm.Secondary = NormalizeHex(e.Value, unitForm.Secondary)" />
                </div>
            </div>
        </div>
        <div class="brand-preview" aria-label="Pré-visualização das cores da unidade">
            <span class="bp-chip" style="background:@(unitForm.InheritPrimary ? overview?.Institution?.Primary : unitForm.Primary);color:@InkFor(unitForm.InheritPrimary ? overview?.Institution?.Primary ?? "#1F4E79" : unitForm.Primary)">Primária</span>
            <span class="bp-chip" style="background:@(unitForm.InheritSecondary ? overview?.Institution?.Secondary : unitForm.Secondary);color:@InkFor(unitForm.InheritSecondary ? overview?.Institution?.Secondary ?? "#D6A94B" : unitForm.Secondary)">Secundária</span>
        </div>
        <p class="hint-line"><Icon Name="sparkles" Size="16" /> Campos marcados para herança acompanham automaticamente a identidade visual da instituição. Uma personalização própria afeta somente esta unidade.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseUnit">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveUnitAsync">@(editingUnit is null ? "Criar unidade" : "Salvar")</button>
    </Footer>
</Modal>

<Modal Open="unitToDeactivate is not null" Eyebrow="Desativar unidade" Title="@(unitToDeactivate?.Name ?? "")" OnClose="CancelUnitDeactivation">
    <ChildContent>
        <p>A unidade deixará de ficar disponível para novas lotações. Para desativá-la, todas as pessoas precisam ser movidas para outra unidade. Deseja continuar?</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelUnitDeactivation">Cancelar</button>
        <button type="button" class="btn btn-danger" disabled="@busy" @onclick="ConfirmUnitDeactivationAsync">Desativar unidade</button>
    </Footer>
</Modal>

@* ───────────── Janela: instituição (criar/editar) ───────────── *@
<Modal Open="showInstitution" Eyebrow="@(creatingInstitution ? "Nova instituição" : "Instituição")" Title="@(creatingInstitution ? "Cadastrar instituição" : "Dados da instituição")" OnClose="CloseInstitution">
    <ChildContent>
        <Feedback Message="@formMessage" IsError="true" />
        @if (Session.User?.Role == UserRole.Admin)
        {
            <div class="field">
                <label for="i-category">Categoria institucional</label>
                <select id="i-category" class="select" value="@instForm.Tipo" @onchange="OnInstitutionTypeChanged">
                    @foreach (var category in Enum.GetValues<TipoInstituicao>())
                    {
                        <option value="@category">@UiFormat.InstitutionTypeLabel(category)</option>
                    }
                </select>
                <small class="muted">Essa classificação descreve a natureza educacional da instituição; não representa Campus, Polo ou Prédio.</small>
                @if (instForm.Tipo == TipoInstituicao.Colegio)
                {
                    <small class="muted">O Colégio Luciano Feijão é uma instituição independente, vinculada ao mantenedor do grupo.</small>
                }
            </div>
        }
        <div class="form-row">
            <div class="field"><label for="i-name">Nome</label><input id="i-name" class="input" @bind="instForm.Name" maxlength="120" /></div>
            <div class="field"><label for="i-sigla">Sigla</label><input id="i-sigla" class="input" @bind="instForm.Sigla" maxlength="10" placeholder="Ex.: CLF" /></div>
        </div>
        <div class="form-row">
            <div class="field"><label for="i-cnpj">CNPJ</label><input id="i-cnpj" class="input" @bind="instForm.Cnpj" maxlength="18" /></div>
            <div class="field"><label for="i-phone">Telefone</label><input id="i-phone" class="input" @bind="instForm.Phone" maxlength="30" /></div>
        </div>
        <div class="field"><label for="i-mail">E-mail</label><input id="i-mail" class="input" @bind="instForm.Email" maxlength="120" /></div>
        <div class="field"><label for="i-addr">Endereço</label><input id="i-addr" class="input" @bind="instForm.Address" maxlength="200" /></div>
        @if (Session.User?.Role == UserRole.Admin)
        {
            <div class="field">
                <label for="i-mant">Mantenedor (dono)@(instForm.Tipo == TipoInstituicao.Colegio ? "" : " - opcional")</label>
                <select id="i-mant" class="select" @bind="mantenedorChoice">
                    <option value="">Sem mantenedor</option>
                    @foreach (var m in overview?.Mantenedores ?? new()) { <option value="@m.Id">@m.Name</option> }
                    <option value="new">Novo mantenedor…</option>
                </select>
                @if (mantenedorChoice == "new")
                {
                    <input class="input" style="margin-top:8px" @bind="instForm.NewMantenedorName" maxlength="120" placeholder="Nome do mantenedor" aria-label="Nome do novo mantenedor" />
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseInstitution">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveInstitutionAsync">@(creatingInstitution ? "Cadastrar" : "Salvar")</button>
    </Footer>
</Modal>

@* ───────────── NOVO: identidade visual (logotipo e cores) ───────────── *@
<Modal Open="showBrand" Eyebrow="Identidade visual" Title="@(overview?.Institution?.Name ?? "Instituição")" OnClose="CloseBrand">
    <ChildContent>
        <Feedback Message="@brandMessage" IsError="@brandError" />
        @if (overview?.Institution is { } bi)
        {
            <div class="field">
                <label>Logotipo ou ícone</label>
                <div class="brand-logo-edit">
                    <div class="logo-box">
                        @if (bi.HasLogo) { <img src="/ui/instituicao-logo/@bi.Id?v=@bi.LogoVersion" alt="Logotipo atual" /> }
                        else { <span class="brand-mono big" style="background:@brandPrimary;color:@InkFor(brandPrimary)" aria-hidden="true">@(string.IsNullOrWhiteSpace(bi.Sigla) ? "—" : bi.Sigla)</span> }
                    </div>
                    <div class="dropzone @(uploadingLogo ? "busy" : "")">
                        <InputFile OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/webp,image/gif" aria-label="Escolher logotipo" />
                        @if (uploadingLogo) { <span class="spinner"></span><strong>Enviando…</strong> }
                        else { <span class="dz-ico"><Icon Name="upload" Size="22" /></span><strong>Clique ou arraste uma imagem</strong><small>PNG, JPG, WebP ou GIF até 8 MB. Fundo transparente é mantido.</small> }
                    </div>
                </div>
                @if (bi.HasLogo)
                {
                    <button type="button" class="btn-text danger" @onclick="RemoveLogoAsync"><Icon Name="trash" Size="16" /> Remover logotipo</button>
                }
            </div>
            <div class="form-row">
                <div class="field">
                    <label for="b-primary">Cor primária</label>
                    <div class="color-field">
                        <input id="b-primary" type="color" value="@brandPrimary" @onchange="e => brandPrimary = NormalizeHex(e.Value, brandPrimary)" />
                        <input class="input" value="@brandPrimary" maxlength="7" aria-label="Código da cor primária" @onchange="e => brandPrimary = NormalizeHex(e.Value, brandPrimary)" />
                    </div>
                </div>
                <div class="field">
                    <label for="b-secondary">Cor secundária</label>
                    <div class="color-field">
                        <input id="b-secondary" type="color" value="@brandSecondary" @onchange="e => brandSecondary = NormalizeHex(e.Value, brandSecondary)" />
                        <input class="input" value="@brandSecondary" maxlength="7" aria-label="Código da cor secundária" @onchange="e => brandSecondary = NormalizeHex(e.Value, brandSecondary)" />
                    </div>
                </div>
            </div>
            <div class="brand-preview" aria-label="Pré-visualização das cores">
                <span class="bp-chip" style="background:@brandPrimary;color:@InkFor(brandPrimary)">@(string.IsNullOrWhiteSpace(bi.Sigla) ? "Primária" : bi.Sigla)</span>
                <span class="bp-chip" style="background:@brandSecondary;color:@InkFor(brandSecondary)">Secundária</span>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseBrand">Fechar</button>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveBrandAsync">Salvar cores</button>
    </Footer>
</Modal>

@code {
    private InstitutionOverview? overview;
    private List<UnitPersonRow>? people;

    private Guid? unitFilter;
    private string search = "";

    private bool showUnit, showInstitution, busy;
    // NOVO: criação de instituição, identidade visual e filtro de não vinculadas
    private bool creatingInstitution, showBrand, uploadingLogo, brandError, showUnlinked, uploadingUnitLogo;
    private string mantenedorChoice = "";
    private string brandPrimary = "#1F4E79", brandSecondary = "#D6A94B";
    private string? brandMessage;
    private UnitCard? editingUnit;
    private UnitCard? unitToDeactivate;
    private IBrowserFile? pendingUnitLogo;
    private readonly UnitForm unitForm = new();
    private readonly InstitutionForm instForm = new();
    private string? formMessage, message, toast;
    private int toastId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (UnauthorizedAccessException ex) { message = ex.Message; overview ??= new InstitutionOverview(null, new(), 0); }
    }

    private async Task ReloadAsync()
    {
        overview = await Institution.GetOverviewAsync();
        people = await Institution.GetPeopleAsync(unitFilter, search, showUnlinked);
    }

    // ───── filtros ─────
    private async Task FilterUnit(Guid? id) { showUnlinked = false; unitFilter = id; people = await Institution.GetPeopleAsync(unitFilter, search, showUnlinked); }
    private async Task FilterUnlinked() { showUnlinked = true; unitFilter = null; people = await Institution.GetPeopleAsync(unitFilter, search, showUnlinked); }
    private async Task OnSearch(ChangeEventArgs e) { search = e.Value?.ToString() ?? ""; people = await Institution.GetPeopleAsync(unitFilter, search, showUnlinked); }

    // ───── lotação ─────
    private async Task AssignAsync(Guid userId, string? value)
    {
        Guid? unitId = Guid.TryParse(value, out var id) ? id : null;
        try
        {
            await Institution.AssignUnitAsync(userId, unitId);
            await ReloadAsync();
            // Se a pessoa mexida é quem está logada, o próprio painel muda de cores agora.
            if (userId == Session.User?.Id) await Session.RefreshUnitAsync();
            Toast("Lotação atualizada.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message;
            await ReloadAsync();
        }
    }

    private async Task SetLinkAsync(Guid userId, bool linked)
    {
        try
        {
            await Institution.SetLinkAsync(userId, linked);
            await ReloadAsync();
            Toast(linked ? "Pessoa vinculada a esta instituição." : "Pessoa desvinculada desta instituição.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException)
        {
            message = ex.Message;
            await ReloadAsync();
        }
    }

    // ───── unidades ─────
    private void OpenUnitCreate()
    {
        editingUnit = null;
        unitForm.Name = ""; unitForm.Sigla = ""; unitForm.Type = TipoUnidade.Campus;
        unitForm.InheritPrimary = true; unitForm.InheritSecondary = true;
        unitForm.Primary = overview?.Institution?.Primary ?? "#1F4E79";
        unitForm.Secondary = overview?.Institution?.Secondary ?? "#D6A94B";
        unitForm.RemoveLogo = false; pendingUnitLogo = null;
        formMessage = null; showUnit = true;
    }

    private void OpenUnitEdit(UnitCard unit)
    {
        editingUnit = unit;
        unitForm.Name = unit.Name; unitForm.Sigla = unit.Sigla; unitForm.Type = unit.Type;
        unitForm.InheritPrimary = unit.Primary is null; unitForm.InheritSecondary = unit.Secondary is null;
        unitForm.Primary = unit.Primary ?? overview?.Institution?.Primary ?? "#1F4E79";
        unitForm.Secondary = unit.Secondary ?? overview?.Institution?.Secondary ?? "#D6A94B";
        unitForm.RemoveLogo = false; pendingUnitLogo = null;
        formMessage = null; showUnit = true;
    }

    private void CloseUnit() { showUnit = false; pendingUnitLogo = null; }

    private void OnUnitLogoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > ImageStorageService.MaxUploadBytes)
        {
            formMessage = "A imagem passa de 8 MB. Escolha uma menor.";
            return;
        }
        pendingUnitLogo = file;
        unitForm.RemoveLogo = false;
        formMessage = null;
    }

    private void RemoveUnitLogo()
    {
        pendingUnitLogo = null;
        unitForm.RemoveLogo = true;
    }

    private async Task SaveUnitAsync()
    {
        busy = true;
        uploadingUnitLogo = pendingUnitLogo is not null;
        formMessage = null;
        Stream? logoStream = null;
        try
        {
            if (pendingUnitLogo is not null)
                logoStream = pendingUnitLogo.OpenReadStream(ImageStorageService.MaxUploadBytes);

            await Institution.SaveUnitAsync(overview!.Institution!.Id, editingUnit?.Id, unitForm, logoStream);
            showUnit = false;
            pendingUnitLogo = null;
            await ReloadAsync();
            Toast(editingUnit is null ? "Unidade criada." : "Unidade atualizada.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or IOException)
        { formMessage = ex.Message; }
        finally
        {
            if (logoStream is not null) await logoStream.DisposeAsync();
            busy = false;
            uploadingUnitLogo = false;
        }
    }

    private async Task ToggleUnit(UnitCard unit)
    {
        if (unit.Active)
        {
            unitToDeactivate = unit;
            return;
        }

        await SetUnitActiveAsync(unit, true);
    }

    private void CancelUnitDeactivation() => unitToDeactivate = null;

    private async Task ConfirmUnitDeactivationAsync()
    {
        if (unitToDeactivate is null) return;
        var unit = unitToDeactivate;
        unitToDeactivate = null;
        await SetUnitActiveAsync(unit, false);
    }

    private async Task SetUnitActiveAsync(UnitCard unit, bool active)
    {
        try
        {
            await Institution.SetUnitActiveAsync(unit.Id, active);
            await ReloadAsync();
            if (Session.User?.Role == UserRole.Admin) await Session.RefreshUnitAsync();
            Toast(active ? "Unidade reativada." : "Unidade desativada.");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; }
    }

    private void PreviewCourseTheme()
    {
        Session.SetThemeChoice("course:medicina");
        Toast("Visualizando o perfil do curso de Medicina. Volte à \"Visão da rede\" no topo quando quiser.");
    }

    private void PreviewTheme(Guid unitId)
    {
        Session.SetThemeChoice("unit:" + unitId);
        Toast("Visualizando o tema desta unidade. Volte à \"Visão da rede\" no topo quando quiser.");
    }

    // ───── instituição ─────
    private void OpenInstitutionEdit()
    {
        var i = overview!.Institution!;
        creatingInstitution = false;
        instForm.Name = i.Name; instForm.Cnpj = i.Cnpj; instForm.Email = i.Email; instForm.Phone = i.Phone; instForm.Address = i.Address;
        instForm.Tipo = i.Tipo; instForm.Sigla = i.Sigla ?? ""; instForm.MantenedorId = i.MantenedorId; instForm.NewMantenedorName = "";
        mantenedorChoice = i.MantenedorId?.ToString() ?? "";
        formMessage = null; showInstitution = true;
    }

    // NOVO: cadastro de instituição (Admin). Nasce como Faculdade; "Colégio (CLF)" preenche nome e sigla e já usa
    // o mantenedor da instituição em uso, para o CLF ficar ligado ao mesmo dono.
    private void OpenInstitutionCreate()
    {
        creatingInstitution = true;
        instForm.Name = ""; instForm.Cnpj = ""; instForm.Email = ""; instForm.Phone = ""; instForm.Address = "";
        instForm.Tipo = TipoInstituicao.Faculdade; instForm.Sigla = ""; instForm.MantenedorId = null; instForm.NewMantenedorName = "";
        mantenedorChoice = overview?.Institution?.MantenedorId?.ToString() ?? "";
        formMessage = null; showInstitution = true;
    }

    private void OnInstitutionTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<TipoInstituicao>(e.Value?.ToString(), out var tipo) && Enum.IsDefined(tipo))
            SetTipo(tipo);
    }

    private void SetTipo(TipoInstituicao tipo)
    {
        instForm.Tipo = tipo;
        if (creatingInstitution && tipo == TipoInstituicao.Colegio)
        {
            if (string.IsNullOrWhiteSpace(instForm.Name)) instForm.Name = "Colégio Luciano Feijão";
            if (string.IsNullOrWhiteSpace(instForm.Sigla)) instForm.Sigla = "CLF";
            if (mantenedorChoice == "" && overview?.Institution?.MantenedorId is Guid m) mantenedorChoice = m.ToString();
        }
    }

    private void CloseInstitution() => showInstitution = false;

    private async Task SaveInstitutionAsync()
    {
        busy = true;
        formMessage = null;
        try
        {
            if (mantenedorChoice == "new" && string.IsNullOrWhiteSpace(instForm.NewMantenedorName))
                throw new ArgumentException("Informe o nome do novo mantenedor.");
            instForm.MantenedorId = Guid.TryParse(mantenedorChoice, out var mid) ? mid : null;
            if (mantenedorChoice != "new") instForm.NewMantenedorName = "";
            if (creatingInstitution)
            {
                var id = await Institution.CreateInstitutionAsync(instForm);
                showInstitution = false;
                await Session.RefreshUnitAsync();   // a nova instituição passa a aparecer no seletor do topo
                await ReloadAsync();
                Toast("Instituição cadastrada. Use \"Gerenciar\" na rede (ou o seletor no topo) para trabalhar nela.");
            }
            else
            {
                await Institution.SaveInstitutionAsync(overview!.Institution!.Id, instForm);
                showInstitution = false;
                await Session.RefreshUnitAsync();
                await ReloadAsync();
                Toast("Dados da instituição atualizados.");
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { formMessage = ex.Message; }
        finally { busy = false; }
    }

    // ───── NOVO: identidade visual ─────
    private void OpenBrand()
    {
        var i = overview!.Institution!;
        brandPrimary = i.Primary; brandSecondary = i.Secondary;
        brandMessage = null; brandError = false; showBrand = true;
    }

    private void CloseBrand() => showBrand = false;

    private async Task SaveBrandAsync()
    {
        busy = true; brandMessage = null;
        try
        {
            await Institution.SaveBrandingAsync(overview!.Institution!.Id, brandPrimary, brandSecondary);
            await ReloadAsync();
            showBrand = false;
            Toast("Identidade visual salva.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { brandMessage = ex.Message; brandError = true; }
        finally { busy = false; }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        brandMessage = null; brandError = false; uploadingLogo = true;
        try
        {
            var file = e.File;
            if (file.Size > ImageStorageService.MaxUploadBytes)
                throw new ArgumentException("A imagem passa de 8 MB. Escolha uma menor.");
            await using var stream = file.OpenReadStream(ImageStorageService.MaxUploadBytes);
            await Institution.UploadLogoAsync(overview!.Institution!.Id, stream);
            await ReloadAsync();
            brandMessage = "Logotipo atualizado.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or IOException)
        { brandMessage = ex.Message; brandError = true; }
        finally { uploadingLogo = false; }
    }

    private async Task RemoveLogoAsync()
    {
        try
        {
            await Institution.RemoveLogoAsync(overview!.Institution!.Id);
            await ReloadAsync();
            brandMessage = "Logotipo removido."; brandError = false;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { brandMessage = ex.Message; brandError = true; }
    }

    private static string TipoUnidadeLabel(TipoUnidade tipo) => tipo switch
    {
        TipoUnidade.Campus => "Campus",
        TipoUnidade.Polo => "Polo",
        TipoUnidade.Predio => "Prédio",
        _ => "Tipo não identificado"
    };

    // Aceita só #RRGGBB (o seletor de cor do navegador já entrega nesse formato); se digitarem algo inválido, mantém a cor anterior.
    private static string NormalizeHex(object? value, string fallback)
    {
        var text = (value?.ToString() ?? "").Trim();
        if (text.Length == 6 && !text.StartsWith('#')) text = "#" + text;
        return InstituicaoModel.IsHexColor(text) ? text.ToUpperInvariant() : fallback;
    }

    private static string InkFor(string hex) => new InstitutionBrand(Guid.Empty, "", null, TipoInstituicao.Faculdade, false, 0, hex, hex).PrimaryInk;

    private void Toast(string text)
    {
        toast = text;
        toastId++;
        message = null;
    }
}
