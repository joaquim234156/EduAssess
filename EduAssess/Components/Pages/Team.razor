@page "/equipe"
@inject UiSession Session
@inject AcademicDashboardService Academic
@inject AccountRegistrationService Accounts
@inject NavigationManager Navigation

<PageTitle>Equipe | EduAssess</PageTitle>
<div class="page-heading"><div><div class="eyebrow">EQUIPE ACADÊMICA</div><h1>Equipe</h1><p>A criação de cada perfil segue a hierarquia de permissões.</p></div></div>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @alertClass">@message</div> }
<div class="page-columns">
    @if (Session.CanCreateManager)
    {
        <section class="panel form-panel">
            <div class="panel-heading"><div><h2>Novo gestor</h2><p>Somente Admin pode criar uma conta Gestor.</p></div></div>
            <EditForm Model="managerForm" OnValidSubmit="CreateManagerAsync">
                <DataAnnotationsValidator />
                <label class="field-label">Nome completo</label><InputText class="text-input" @bind-Value="managerForm.Name" /><ValidationMessage For="@(() => managerForm.Name)" />
                <label class="field-label">E-mail</label><InputText class="text-input" @bind-Value="managerForm.Email" /><ValidationMessage For="@(() => managerForm.Email)" />
                <div class="form-row">
                    <div><label class="field-label">CPF</label><InputText class="text-input" @bind-Value="managerForm.Cpf" inputmode="numeric" /><ValidationMessage For="@(() => managerForm.Cpf)" /></div>
                    <div><label class="field-label">Telefone</label><InputText class="text-input" @bind-Value="managerForm.Phone" inputmode="numeric" /><ValidationMessage For="@(() => managerForm.Phone)" /></div>
                </div>
                <label class="field-label">Data de nascimento</label><InputDate class="text-input" @bind-Value="managerForm.BirthDate" /><ValidationMessage For="@(() => managerForm.BirthDate)" />
                <label class="field-label">Senha</label><InputText class="text-input" @bind-Value="managerForm.Password" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => managerForm.Password)" />
                <label class="field-label">Confirmar senha</label><InputText class="text-input" @bind-Value="managerForm.ConfirmPassword" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => managerForm.ConfirmPassword)" />
                <button class="button button-primary full-button" type="submit" disabled="@busy">@(busy ? "Criando..." : "Criar gestor")</button>
            </EditForm>
        </section>
    }
    @if (Session.CanCreateProfessor)
    {
        <section class="panel form-panel">
            <div class="panel-heading"><div><h2>Novo professor</h2><p>Somente Gestor pode criar uma conta Professor.</p></div></div>
            <EditForm Model="professorForm" OnValidSubmit="CreateProfessorAsync">
                <DataAnnotationsValidator />
                <label class="field-label">Nome completo</label><InputText class="text-input" @bind-Value="professorForm.Name" /><ValidationMessage For="@(() => professorForm.Name)" />
                <label class="field-label">E-mail</label><InputText class="text-input" @bind-Value="professorForm.Email" /><ValidationMessage For="@(() => professorForm.Email)" />
                <div class="form-row">
                    <div><label class="field-label">CPF</label><InputText class="text-input" @bind-Value="professorForm.Cpf" inputmode="numeric" /><ValidationMessage For="@(() => professorForm.Cpf)" /></div>
                    <div><label class="field-label">Telefone</label><InputText class="text-input" @bind-Value="professorForm.Phone" inputmode="numeric" /><ValidationMessage For="@(() => professorForm.Phone)" /></div>
                </div>
                <label class="field-label">Data de nascimento</label><InputDate class="text-input" @bind-Value="professorForm.BirthDate" /><ValidationMessage For="@(() => professorForm.BirthDate)" />
                <label class="field-label">Senha</label><InputText class="text-input" @bind-Value="professorForm.Password" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => professorForm.Password)" />
                <label class="field-label">Confirmar senha</label><InputText class="text-input" @bind-Value="professorForm.ConfirmPassword" type="password" autocomplete="new-password" /><ValidationMessage For="@(() => professorForm.ConfirmPassword)" />
                <button class="button button-primary full-button" type="submit" disabled="@busy">@(busy ? "Criando..." : "Criar professor")</button>
            </EditForm>
        </section>
    }
    <section class="panel list-panel">
        <div class="panel-heading"><div><h2>Equipe docente</h2><p>Professores ativos na plataforma</p></div><span class="count-pill">@instructors.Count</span></div>
        @if (instructors.Count == 0) { <div class="empty-state"><div class="empty-icon">♧</div><strong>Nenhum professor cadastrado</strong><span>Gestores podem cadastrar docentes para vinculá-los às turmas.</span></div> }
        else
        {
            <div class="table-wrap"><table><thead><tr><th>PROFESSOR</th><th>IDENTIFICAÇÃO</th></tr></thead><tbody>
                @foreach (var teacher in instructors)
                {
                    <tr><td><div class="table-person"><span class="avatar avatar-small">@GetInitials(teacher.Name)</span><strong>@teacher.Name</strong></div></td><td><span class="badge badge-violet">Docente</span></td></tr>
                }
            </tbody></table></div>
        }
    </section>
</div>

@code {
    private List<InstructorRow> instructors = [];
    private AccountRegistrationForm managerForm = new();
    private AccountRegistrationForm professorForm = new();
    private string? message;
    private string alertClass = "alert-success";
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.CanManage) { Navigation.NavigateTo(Session.CanAssignStudents ? "/alunos" : "/login"); return; }
        await LoadAsync();
    }

    private async Task LoadAsync() => instructors = await Academic.GetInstructorsAsync();

    private async Task CreateManagerAsync()
    {
        await CreateAsync(async () =>
        {
            await Accounts.CreateManagerAsync(
                Session.User!.Role, managerForm.Name, managerForm.Email, managerForm.Cpf, managerForm.Phone,
                managerForm.BirthDate, managerForm.Password, managerForm.ConfirmPassword);
            managerForm = new AccountRegistrationForm();
            message = "Gestor cadastrado com sucesso.";
        });
    }

    private async Task CreateProfessorAsync()
    {
        await CreateAsync(async () =>
        {
            await Academic.CreateInstructorAsync(
                professorForm.Name, professorForm.Email, professorForm.Cpf, professorForm.Phone,
                professorForm.BirthDate, professorForm.Password, professorForm.ConfirmPassword);
            professorForm = new AccountRegistrationForm();
            message = "Professor cadastrado com sucesso.";
            await LoadAsync();
        });
    }

    private async Task CreateAsync(Func<Task> operation)
    {
        busy = true;
        message = null;
        try
        {
            await operation();
            alertClass = "alert-success";
        }
        catch (AccountConflictException ex)
        {
            message = ex.Message;
            alertClass = "alert-error";
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException)
        {
            message = ex.Message;
            alertClass = "alert-error";
        }
        finally
        {
            busy = false;
        }
    }

    private static string GetInitials(string name) => string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));
}
