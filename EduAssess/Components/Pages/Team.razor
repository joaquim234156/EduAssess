@page "/equipe"
@using global::EduAssess.Models.Local
@layout AppLayout
@attribute [Authorize(Policy = "Gestao")]
@inject UiSession Session
@inject AcademicService Academic
@inject AccountRegistrationService Accounts

<PageTitle>Equipe | EduAssess</PageTitle>

<PageHeader Eyebrow="Pessoas" Title="Equipe" Subtitle="@(Session.CanCreateManager ? "Como administrador, você cria gestores. Gestores cadastram os professores." : "Como gestor, você cadastra os professores da instituição.")" />

<Feedback Message="@message" IsError="@isError" />

<div class="cols">
    <div class="card sticky">
        @if (Session.User is null)
        {
            <div class="loading"><span class="spinner"></span></div>
        }
        else if (!Session.CanCreateManager && !Session.CanCreateProfessor)
        {
            <EmptyState IconName="lock" Title="Sem permissão" Text="Seu perfil não cria contas de equipe." />
        }
        else
        {
            <div class="card-head"><div><h2>@(Session.CanCreateManager ? "Novo gestor" : "Novo professor")</h2><p>A conta já nasce com o perfil definido.</p></div></div>
            <EditForm Model="form" OnValidSubmit="CreateAsync" FormName="equipe">
                <DataAnnotationsValidator />
                <div class="field"><label for="e-name">Nome completo</label><InputText id="e-name" class="input" @bind-Value="form.Name" /><ValidationMessage For="@(() => form.Name)" /></div>
                <div class="field"><label for="e-email">E-mail</label><InputText id="e-email" class="input" @bind-Value="form.Email" /><ValidationMessage For="@(() => form.Email)" /></div>
                <div class="form-row">
                    <div class="field"><label for="e-cpf">CPF</label><InputText id="e-cpf" class="input" @bind-Value="form.Cpf" inputmode="numeric" placeholder="000.000.000-00" /><ValidationMessage For="@(() => form.Cpf)" /></div>
                    <div class="field"><label for="e-phone">Telefone</label><InputText id="e-phone" class="input" @bind-Value="form.Phone" inputmode="numeric" placeholder="(11) 90000-0000" /><ValidationMessage For="@(() => form.Phone)" /></div>
                </div>
                <div class="field"><label for="e-birth">Data de nascimento</label><InputDate id="e-birth" class="input" @bind-Value="form.BirthDate" /><ValidationMessage For="@(() => form.BirthDate)" /></div>
                <div class="form-row">
                    <div class="field"><label for="e-pass">Senha inicial</label><InputText id="e-pass" type="password" class="input" @bind-Value="form.Password" autocomplete="new-password" /><ValidationMessage For="@(() => form.Password)" /></div>
                    <div class="field"><label for="e-pass2">Confirmar</label><InputText id="e-pass2" type="password" class="input" @bind-Value="form.ConfirmPassword" autocomplete="new-password" /><ValidationMessage For="@(() => form.ConfirmPassword)" /></div>
                </div>
                <button class="btn btn-primary" type="submit" disabled="@busy">@(Session.CanCreateManager ? "Criar gestor" : "Criar professor")</button>
            </EditForm>
        }
    </div>

    <div class="card">
        <div class="card-head"><div><h2>Gestores e professores</h2><p>Contas ativas da equipe.</p></div><span class="count-pill">@(staff?.Count ?? 0)</span></div>
        @if (staff is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (staff.Count == 0)
        {
            <EmptyState IconName="users" Title="Equipe vazia" Text="Cadastre o primeiro membro da equipe usando o formulário." />
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th></tr></thead>
                    <tbody>
                        @foreach (var person in staff)
                        {
                            <tr>
                                <td><div class="person"><div class="avatar sm">@UiFormat.Initials(person.Name)</div><strong>@person.Name</strong></div></td>
                                <td>@person.Email</td>
                                <td><span class="badge @(person.Role == UserRole.Gestor ? "badge-blue" : "badge-violet")">@UiFormat.RoleLabel(person.Role)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<StaffRow>? staff;
    private AccountRegistrationForm form = new();
    private string? message;
    private bool isError;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { staff = await Academic.GetStaffAsync(); }
        catch (UnauthorizedAccessException ex) { message = ex.Message; isError = true; staff ??= new(); }
    }

    private async Task CreateAsync()
    {
        busy = true;
        try
        {
            var actor = await Session.RequireAsync(UserRole.Admin, UserRole.Gestor);
            if (actor.Role == UserRole.Admin)
                await Accounts.CreateManagerAsync(actor.Role, form.Name, form.Email, form.Cpf, form.Phone, form.BirthDate, form.Password, form.ConfirmPassword);
            else
                await Accounts.CreateProfessorAsync(actor.Role, form.Name, form.Email, form.Cpf, form.Phone, form.BirthDate, form.Password, form.ConfirmPassword);

            message = (actor.Role == UserRole.Admin ? "Gestor" : "Professor") + " criado com sucesso."; isError = false;
            form = new AccountRegistrationForm();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or AccountConflictException or UnauthorizedAccessException)
        {
            message = ex.Message; isError = true;
        }
        finally { busy = false; }
    }
}
