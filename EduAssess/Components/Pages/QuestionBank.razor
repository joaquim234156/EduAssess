@page "/banco-questoes"
@layout AppLayout
@attribute [Authorize(Policy = "Docencia")]
@using global::EduAssess.Models.Local
@using global::EduAssess.Application.DTOs.Selo
@inject QuestaoWebService Questions

<PageTitle>Banco de questões | Faculdade Luciano Feijão</PageTitle>

<PageHeader Eyebrow="Avaliação" Title="Banco de questões" Subtitle="Peça questões à IA, revise e salve, ou escreva à mão. Elas viram provas e ficam disponíveis para os alunos praticarem.">
    <a class="btn btn-ghost" href="/avaliacoes"><Icon Name="clipboard" Size="18" /> Avaliações</a>
</PageHeader>

<Feedback Message="@message" IsError="@isError" />

@if (disciplines is null)
{
    <div class="loading"><span class="spinner"></span> Carregando…</div>
}
else if (disciplines.Count == 0)
{
    <div class="card"><EmptyState IconName="book" Title="Você ainda não tem disciplinas" Text="Peça a um gestor para vincular disciplinas a você. Elas são necessárias para criar questões." /></div>
}
else
{
    @* ───────────── Criar questões (IA ou manual) ───────────── *@
    <section class="card reveal">
        <QuestionComposer Disciplines="disciplines" OnSaved="OnQuestionsSaved" />
    </section>

    @* ───────────── Banco ───────────── *@
    <section class="card" style="margin-top:24px">
        <div class="card-head">
            <div><h2>Minhas questões</h2><p>Clique em uma questão para ver as alternativas e a explicação. Use Editar para corrigir qualquer detalhe, principalmente nas geradas por IA.</p></div>
            <span class="count-pill">@(bank?.Count ?? 0)</span>
        </div>

        <div class="bank-filters">
            <select class="select" aria-label="Filtrar por disciplina" @onchange="OnFilterDiscipline">
                <option value="">Todas as disciplinas</option>
                @foreach (var d in disciplines) { <option value="@d.Id" selected="@(filterDiscipline == d.Id)">@d.Name</option> }
            </select>
            <input class="input" placeholder="Buscar por assunto" value="@filterTopic" @onchange="OnFilterTopic" />
            <div class="seg">
                <button type="button" class="@(filterDifficulty is null ? "on" : "")" @onclick="() => SetFilterDifficulty(null)">Todas</button>
                @foreach (var opt in Difficulties)
                {
                    var level = opt;
                    <button type="button" class="@(filterDifficulty == level ? "on" : "")" @onclick="() => SetFilterDifficulty(level)">@UiFormat.DifficultyLabel(level)</button>
                }
            </div>
        </div>
        @if (sealTypes.Count > 0)
        {
            <div class="chip-row seal-filter" role="group" aria-label="Filtrar por selo">
                <button type="button" class="chip @(filterSeal is null ? "on" : "")" @onclick="() => SetFilterSeal(null)">Todos os selos</button>
                @foreach (var t in sealTypes)
                {
                    var code = t.Codigo;
                    <button type="button" class="chip @(filterSeal == code ? "on" : "")" @onclick="() => SetFilterSeal(code)">@t.Nome</button>
                }
            </div>
        }

        @if (bank is null)
        {
            <div class="loading"><span class="spinner"></span> Carregando…</div>
        }
        else if (bank.Count == 0)
        {
            <EmptyState IconName="inbox" Title="Nenhuma questão por aqui" Text="Gere questões com a IA acima ou escreva uma manualmente." />
        }
        else
        {
            <div class="bank-list">
                @foreach (var q in bank)
                {
                    var question = q;
                    <details class="bank-item">
                        <summary>
                            <span class="bank-main"><strong>@question.Statement</strong><small>@question.DisciplineName · @question.Topic</small><SealBadges Seals="question.Seals" ShowHidden="true" /></span>
                            <span class="badge @DifficultyBadge(question.Difficulty)">@UiFormat.DifficultyLabel(question.Difficulty)</span>
                        </summary>
                        <ol class="alts" type="A">
                            @for (var k = 0; k < question.Alternatives.Count; k++)
                            {
                                <li class="@(k == question.CorrectIndex ? "correct" : "")">@question.Alternatives[k]</li>
                            }
                        </ol>
                        <p class="draft-explain"><Icon Name="check-circle" Size="16" /> @question.Explanation</p>
                        <div class="bank-actions">
                            <button type="button" class="btn-text" @onclick="() => OpenEditAsync(question)"><Icon Name="pen" Size="16" /> Editar questão</button>
                            <button type="button" class="btn-text danger" @onclick="() => AskDelete(question)"><Icon Name="trash" Size="16" /> Apagar questão</button>
                        </div>
                    </details>
                }
            </div>
        }
    </section>
}

@* ───────────── Edição completa da questão ───────────── *@
<Modal Open="editForm is not null" Wide="true" Eyebrow="Editar questão" Title="@(editTarget?.Topic ?? "")" OnClose="CloseEdit">
    <ChildContent>
        @if (editForm is not null && editTarget is not null)
        {
            <Feedback Message="@editError" IsError="true" />
            @if (editTarget.Seals?.Any(x => x.Codigo == "IA") == true)
            {
                <p class="hint-line"><Icon Name="sparkles" Size="16" /> Questão gerada com IA: confira enunciado, gabarito e justificativa antes de usá-la em provas.</p>
            }
            @if (editTarget.AppliedExamCount > 0)
            {
                <p class="hint-line warn"><Icon Name="alert" Size="16" /> Esta questão está em @editTarget.AppliedExamCount avaliação(ões) já aplicada(s). A alteração vale para quem fizer a prova daqui em diante; notas já registradas não mudam.</p>
            }
            else if (editTarget.ExamCount > 0)
            {
                <p class="hint-line"><Icon Name="clipboard" Size="16" /> Esta questão está em @editTarget.ExamCount avaliação(ões); a alteração aparece em todas.</p>
            }
            <div class="form-row">
                <div class="field">
                    <label for="e-disc">Disciplina</label>
                    <select id="e-disc" class="select" @bind="editForm.DisciplineId">
                        @foreach (var d in disciplines!) { <option value="@d.Id">@d.Name</option> }
                    </select>
                </div>
                <div class="field"><label for="e-topic">Assunto</label><input id="e-topic" class="input" @bind="editForm.Topic" maxlength="100" /></div>
            </div>
            <div class="field">
                <label>Dificuldade</label>
                <div class="seg">
                    @foreach (var opt in Difficulties)
                    {
                        var level = opt;
                        <button type="button" class="@(editForm.Difficulty == level ? "on" : "")" @onclick="() => editForm.Difficulty = level">@UiFormat.DifficultyLabel(level)</button>
                    }
                </div>
            </div>
            <QuestionEditor Draft="editForm.Content" Id="edit" />
            <div class="field">
                <label>Selos e classificação</label>
                <SealPicker Types="sealTypes" Choices="editForm.Seals" />
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseEdit">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveEditAsync"><Icon Name="check" Size="16" /> Salvar alterações</button>
    </Footer>
</Modal>

<Modal Open="deleteTarget is not null" Eyebrow="Desativar questão" Title="@(deleteTarget?.Statement ?? "")" OnClose="CancelDelete">
    <ChildContent>
        <p>A questão deixará de aparecer no seu banco e não poderá ser usada em novas avaliações. Se já estiver vinculada a uma avaliação, essa relação histórica será preservada. Deseja continuar?</p>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CancelDelete">Cancelar</button>
        <button type="button" class="btn btn-danger" disabled="@busy" @onclick="ConfirmDeleteAsync"><Icon Name="trash" Size="16" /> Desativar questão</button>
    </Footer>
</Modal>

@code {
    private static readonly DificuldadeQuestao[] Difficulties = [DificuldadeQuestao.Facil, DificuldadeQuestao.Media, DificuldadeQuestao.Dificil];

    private List<DisciplineOption>? disciplines;
    private List<QuestionRow>? bank;

    private Guid? filterDiscipline;
    private string filterTopic = "";
    private DificuldadeQuestao? filterDifficulty;
    private QuestionRow? deleteTarget;
    private bool busy;

    // NOVO: selos e edição
    private List<SeloTipoDto> sealTypes = new();
    private string? filterSeal;
    private QuestionRow? editTarget;
    private QuestionEditForm? editForm;
    private string? editError;

    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            disciplines = await Questions.GetMyDisciplinesAsync();
            sealTypes = await Questions.GetSealTypesAsync();
            await LoadBankAsync();
        }
        catch (UnauthorizedAccessException ex) { Fail(ex.Message); disciplines ??= new(); }
    }

    private async Task LoadBankAsync() =>
        bank = await Questions.GetMyQuestionsAsync(filterDiscipline, filterTopic, filterDifficulty, filterSeal);

    private async Task OnQuestionsSaved(List<Guid> ids)
    {
        await LoadBankAsync();
        Ok($"{ids.Count} questão(ões) salva(s). Já aparecem na lista abaixo.");
    }

    private async Task SetFilterSeal(string? code)
    {
        filterSeal = code;
        await LoadBankAsync();
    }

    private async Task OpenEditAsync(QuestionRow question)
    {
        try
        {
            var row = await Questions.GetQuestionAsync(question.Id);   // recarrega do servidor (posse e dados atuais)
            editTarget = row;
            editError = null;
            editForm = new QuestionEditForm
            {
                DisciplineId = row.DisciplineId,
                Topic = row.Topic,
                Difficulty = row.Difficulty,
                Content = new DraftQuestion
                {
                    Statement = row.Statement,
                    Alternatives = row.Alternatives.ToList(),
                    CorrectIndex = row.CorrectIndex,
                    Explanation = row.Explanation
                },
                Seals = SealPicker.Build(sealTypes, row.Seals)
            };
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Fail(ex.Message); }
    }

    private void CloseEdit() { editForm = null; editTarget = null; editError = null; }

    private async Task SaveEditAsync()
    {
        if (editForm is null || editTarget is null) return;
        busy = true;
        try
        {
            await Questions.UpdateQuestionAsync(editTarget.Id, editForm);
            CloseEdit();
            await LoadBankAsync();
            Ok("Questão atualizada.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { editError = ex.Message; }
        finally { busy = false; }
    }

    private void AskDelete(QuestionRow question) => deleteTarget = question;

    private void CancelDelete() => deleteTarget = null;

    private async Task ConfirmDeleteAsync()
    {
        if (deleteTarget is null) return;
        var id = deleteTarget.Id;
        busy = true;
        try
        {
            await Questions.DisableQuestionAsync(id);
            deleteTarget = null;
            await LoadBankAsync();
            Ok("Questão apagada.");
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { Fail(ex.Message); }
        finally { busy = false; }
    }

    private async Task OnFilterDiscipline(ChangeEventArgs e)
    {
        filterDiscipline = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadBankAsync();
    }

    private async Task OnFilterTopic(ChangeEventArgs e)
    {
        filterTopic = e.Value?.ToString() ?? "";
        await LoadBankAsync();
    }

    private async Task SetFilterDifficulty(DificuldadeQuestao? level)
    {
        filterDifficulty = level;
        await LoadBankAsync();
    }

    private void Ok(string text) { message = text; isError = false; }
    private void Fail(string text) { message = text; isError = true; }

    private static string DifficultyBadge(DificuldadeQuestao d) => d switch
    {
        DificuldadeQuestao.Facil => "badge-green",
        DificuldadeQuestao.Media => "badge-amber",
        _ => "badge-red"
    };
}
