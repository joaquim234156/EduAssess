@* Logo da Faculdade Luciano Feijão.
   Light = true  -> versão toda branca (para fundos azuis/escuros: barra lateral, login, rodapé)
   Light = false -> versão colorida (para fundos claros: cabeçalho do site) *@
<a class="brand @(Light ? "brand-light" : "")" href="@Href" aria-label="Faculdade Luciano Feijão — EduAssess">
    <img src="@(Light ? "img/logo-flf-branca.png" : "img/logo-flf.png")"
         alt="Faculdade Luciano Feijão" height="46" />
</a>

@code {
    [Parameter] public bool Light { get; set; }
    [Parameter] public string Href { get; set; } = "/";
}
