@using global::EduAssess.Models.Local
@inherits LayoutComponentBase
@implements IDisposable
@inject UiSession Session
@inject NavigationManager Nav

@* ALTERADO: o elemento raiz agora recebe as classes de tema (perfil + prédio), ex.: "role-professor unit-medicina".
   Todo o visual exclusivo está em temas.css. O fundo fixo em linha foi para o CSS (.shell { background: var(--paper) }). *@
<div class="shell @Session.ThemeClass @(menuOpen ? "menu-open" : string.Empty) @(sidebarCollapsed ? "sidebar-collapsed" : string.Empty)" style="@Session.ShellStyle">
    <aside class="sidebar" id="primary-navigation">
        <Logo Light="@(!UiTheme.LightSidebar(Session.User?.Role))" Compactable="true" Href="@homePath" Brand="Session.Brand" />

        @* NOVO: selo do prédio (Principal, Medicina, Odontologia) na barra lateral. *@
        @if (Session.IsSignedIn)
        {
            <div class="unit-badge" title="@Session.ThemeLabel">
                <span class="ub-ico"><Icon Name="@UiTheme.KeyIcon(Session.ThemeKey)" Size="20" /></span>
                <div>
                    <small>@Session.InstitutionName</small>
                    <strong>@(Session.ThemeKey == "rede" ? "Todas as unidades" : Session.ThemeLabel)</strong>
                </div>
            </div>
        }

        @if (Session.IsSignedIn)
        {
            @if (Session.CanManage)
            {
                <div class="nav-group">
                    <span>Instituição</span>
                    <NavLink class="nav-link" href="/painel" title="Visão geral" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Visão geral</NavLink>
                    <NavLink class="nav-link" href="/instituicao" title="Unidades e pessoas" @onclick="CloseMenu"><Icon Name="building" /> Unidades e pessoas</NavLink>
                    <NavLink class="nav-link" href="/historico" title="Histórico de atividades" @onclick="CloseMenu"><Icon Name="clock" /> Histórico</NavLink>
                    <NavLink class="nav-link" href="/cursos" title="Cursos" @onclick="CloseMenu"><Icon Name="book" /> Cursos</NavLink>
                    <NavLink class="nav-link" href="/disciplinas" title="Disciplinas" @onclick="CloseMenu"><Icon Name="file" /> Disciplinas</NavLink>
                    <NavLink class="nav-link" href="/turmas" title="Turmas" @onclick="CloseMenu"><Icon Name="layers" /> Turmas</NavLink>
                </div>
                <div class="nav-group">
                    <span>Pessoas</span>
                    <NavLink class="nav-link" href="/equipe" title="Equipe" @onclick="CloseMenu"><Icon Name="users" /> Equipe</NavLink>
                    <NavLink class="nav-link" href="/alunos" title="Alunos" @onclick="CloseMenu"><Icon Name="cap" /> Alunos</NavLink>
                    <NavLink class="nav-link" href="/matriculas" title="Matrículas" @onclick="CloseMenu"><Icon Name="clipboard" /> Matrículas</NavLink>
                </div>
                <div class="nav-group">
                    <span>Avaliação</span>
                    <NavLink class="nav-link" href="/notas" title="Notas" @onclick="CloseMenu"><Icon Name="pen" /> Notas</NavLink>
                    <NavLink class="nav-link" href="/avaliacoes" title="Avaliações" @onclick="CloseMenu"><Icon Name="clipboard" /> Avaliações</NavLink>
                    <NavLink class="nav-link" href="/banco-questoes" title="Banco de questões" @onclick="CloseMenu"><Icon Name="sparkles" /> Banco de questões</NavLink>
                    <NavLink class="nav-link" href="/praticar" title="Ver como aluno" @onclick="CloseMenu"><Icon Name="zap" /> Ver como aluno</NavLink>
                </div>
            }
            else if (Session.IsProfessor)
            {
                <div class="nav-group">
                    <span>Docência</span>
                    <NavLink class="nav-link" href="/professor" title="Meu painel" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Meu painel</NavLink>
                    <NavLink class="nav-link" href="/notas" title="Lançar notas" @onclick="CloseMenu"><Icon Name="pen" /> Lançar notas</NavLink>
                    <NavLink class="nav-link" href="/alunos" title="Alunos" @onclick="CloseMenu"><Icon Name="cap" /> Alunos</NavLink>
                    <NavLink class="nav-link" href="/historico" title="Histórico das minhas turmas e conteúdos" @onclick="CloseMenu"><Icon Name="clock" /> Histórico</NavLink>
                </div>
                <div class="nav-group">
                    <span>Avaliações</span>
                    <NavLink class="nav-link" href="/avaliacoes" title="Provas e simulados" @onclick="CloseMenu"><Icon Name="clipboard" /> Provas e simulados</NavLink>
                    <NavLink class="nav-link" href="/banco-questoes" title="Banco de questões" @onclick="CloseMenu"><Icon Name="sparkles" /> Banco de questões</NavLink>
                    <NavLink class="nav-link" href="/praticar" title="Ver como aluno" @onclick="CloseMenu"><Icon Name="zap" /> Ver como aluno</NavLink>
                </div>
            }
            else if (Session.User?.Role == UserRole.Aluno)
            {
                <div class="nav-group">
                    <span>Estudante</span>
                    <NavLink class="nav-link" href="/aluno" title="Meu painel" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="dashboard" /> Meu painel</NavLink>
                    <NavLink class="nav-link" href="/aluno/notas" title="Minhas notas" @onclick="CloseMenu"><Icon Name="chart" /> Minhas notas</NavLink>
                    <NavLink class="nav-link" href="/praticar" title="Praticar questões" @onclick="CloseMenu"><Icon Name="zap" /> Praticar questões</NavLink>
                </div>
            }
            else
            {
                <div class="nav-group">
                    <span>Conta</span>
                    <NavLink class="nav-link" href="/aguardando" title="Status do acesso" Match="NavLinkMatch.All" @onclick="CloseMenu"><Icon Name="clock" /> Status do acesso</NavLink>
                </div>
            }

            <div class="nav-group">
                <span>Minha área</span>
                <NavLink class="nav-link" href="/conta" title="Minha conta" @onclick="CloseMenu"><Icon Name="user-circle" /> Minha conta</NavLink>
            </div>

            <div class="sidebar-foot">
                <div class="who" title="@Session.User?.Name">
                    <AvatarImage UserId="Session.User!.Id" Name="@Session.User.Name" Stamp="Session.AvatarStamp" />
                    <div>
                        <strong>@Session.User?.Name</strong>
                        <small>@(Session.User is null ? "" : UiFormat.RoleLabel(Session.User.Role))</small>
                    </div>
                </div>
                <form method="post" action="/ui/logout">
                    <button type="submit" class="signout" title="Sair da conta"><Icon Name="logout" Size="18" /> Sair da conta</button>
                </form>
            </div>
        }
    </aside>
    <button type="button" class="menu-scrim" aria-label="Fechar menu" @onclick="CloseMenu"></button>

    <div class="main">
        <header class="topbar">
            <div class="topbar-start">
                <button type="button" class="sidebar-collapse" aria-label="@(sidebarCollapsed ? "Expandir menu" : "Recolher menu")" aria-controls="primary-navigation" aria-expanded="@(!sidebarCollapsed)" @onclick="ToggleSidebar">
                    <Icon Name="@(sidebarCollapsed ? "arrow-right" : "arrow-left")" Size="20" />
                </button>
                <button type="button" class="menu-burger" aria-label="Abrir menu" aria-controls="primary-navigation" aria-expanded="@menuOpen" @onclick="ToggleMenu">
                    <svg class="bi bi-list" width="21" height="21" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                    </svg>
                </button>
                <div class="hello">
                    <span class="hello-date">@UiFormat.LongDate(DateTime.Now)</span>
                    <b>@UiTheme.Greeting(Session.User?.Role, UiFormat.FirstName(Session.User?.Name))</b>
                </div>
            </div>
            <div class="topbar-right">
                @if (Session.User is not null)
                {
                    @* NOVO: quem atua em mais de uma instituição (ex.: Faculdade e Colégio CLF) escolhe qual usar. A escolha
                       vai para o cookie (POST /ui/instituicao/selecionar), então sobrevive ao recarregar a página. *@
                    @if (Session.AvailableInstitutions.Count > 1)
                    {
                        <form method="post" action="/ui/instituicao/selecionar" class="inst-switch-form">
                            <input type="hidden" name="returnUrl" value="/@Nav.ToBaseRelativePath(Nav.Uri)" />
                            <select name="id" class="unit-switch inst-switch" aria-label="Instituição em uso" onchange="this.form.submit()">
                                @foreach (var inst in Session.AvailableInstitutions)
                                {
                                    <option value="@inst.Id" selected="@(Session.InstitutionId == inst.Id)">@(string.IsNullOrEmpty(inst.Sigla) ? inst.Name : inst.Sigla + " · " + inst.Name)</option>
                                }
                            </select>
                            <noscript><button type="submit" class="btn btn-ghost btn-sm">Trocar</button></noscript>
                        </form>
                    }

                    @* NOVO: só o Admin vê este seletor: ele pode "ver como" qualquer prédio para conferir o tema. *@
                    @if (Session.User.Role == UserRole.Admin && Session.AllUnits.Count > 0)
                    {
                        <select class="unit-switch" aria-label="Ver como prédio ou curso" @onchange="OnThemeUnit">
                            <option value="" selected="@(Session.ThemeChoice == "")">Visão da rede</option>
                            @foreach (var u in Session.AllUnits)
                            {
                                <option value="unit:@u.Id" selected="@(Session.ThemeChoice == "unit:" + u.Id)">@u.Name</option>
                            }
                            <option value="course:medicina" selected="@Session.ThemeOverrideCourse">Perfil: Curso de Medicina</option>
                        </select>
                    }
                    <span class="badge-role role-chip">
                        <Icon Name="@UiTheme.RoleIcon(Session.User.Role)" Size="14" />
                        @UiFormat.RoleLabel(Session.User.Role)@(string.IsNullOrEmpty(Session.ThemeShort) ? "" : " · " + Session.ThemeShort)
                    </span>
                    <ThemeToggle Class="theme-toggle-panel" />
                    <a href="/conta" aria-label="Minha conta"><AvatarImage UserId="Session.User.Id" Name="@Session.User.Name" Class="sm" Stamp="Session.AvatarStamp" /></a>
                }
            </div>
        </header>
        <div class="page">@Body</div>
        <footer class="page-foot">@(Session.Brand?.Name ?? "Faculdade Luciano Feijão")@(Session.ThemeKey == "rede" ? "" : " · " + Session.ThemeLabel) · EduAssess</footer>
    </div>
</div>

@code {
    private bool menuOpen;
    private bool sidebarCollapsed;
    private string homePath = "/painel";

    protected override async Task OnInitializedAsync()
    {
        // Quando a foto de perfil muda (tela "Minha conta"), redesenha o menu e o topo na hora.
        Session.Changed += OnSessionChanged;
        await Session.InitializeAsync();
        if (Session.User is not null)
            homePath = UiFormat.HomePath(Session.User.Role);
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;

    private void CloseMenu() => menuOpen = false;

    // NOVO: o Admin escolhe "ver como" um prédio ou o perfil do curso de Medicina; o tema muda na hora.
    private void OnThemeUnit(ChangeEventArgs e) => Session.SetThemeChoice(e.Value?.ToString());

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
