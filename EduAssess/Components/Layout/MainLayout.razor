@implements IDisposable
@inherits LayoutComponentBase
@inject UiSession Session
@inject NavigationManager Navigation

<div class="app-shell">
    @if (Session.IsSignedIn)
    {
        <aside class="sidebar">
            <a class="brand" href="/"><span class="brand-mark">E</span><span>Edu<span>Assess</span><small>GESTÃO ACADÊMICA</small></span></a>
            <div class="nav-label">MENU PRINCIPAL</div>
            <nav class="main-nav">
                @if (Session.CanManage)
                {
                    <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span> Visão geral</NavLink>
                    <NavLink href="/cursos"><span class="nav-icon">▤</span> Cursos</NavLink>
                    <NavLink href="/turmas"><span class="nav-icon">▦</span> Turmas</NavLink>
                    <NavLink href="/equipe"><span class="nav-icon">♧</span> Equipe</NavLink>
                    <NavLink href="/matriculas"><span class="nav-icon">▣</span> Matrículas</NavLink>
                    <NavLink href="/notas"><span class="nav-icon">✎</span> Notas</NavLink>
                }
                <NavLink href="/alunos"><span class="nav-icon">♙</span> Alunos</NavLink>
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-user">
                    <div class="avatar">@Initials</div>
                    <div class="user-meta"><strong>@Session.User?.Name</strong><span>@Session.User?.Role</span></div>
                </div>
                <button class="signout-button" @onclick="SignOut">Sair da conta <span>↗</span></button>
            </div>
        </aside>
        <main class="main-area">
            <header class="topbar">
                <div><div class="eyebrow">PORTAL EDUCACIONAL</div><div class="topbar-title">Olá, @(Session.User?.Name.Split(' ')[0]) <span>✦</span></div></div>
                <div class="topbar-right"><span class="status-dot"></span> Ambiente conectado <span class="topbar-date">@DateTime.Now.ToString("dd 'de' MMMM, yyyy", new System.Globalization.CultureInfo("pt-BR"))</span></div>
            </header>
            <div class="page-content">@Body</div>
            <footer class="footer">EduAssess <span>•</span> Plataforma de gestão acadêmica</footer>
        </main>
    }
    else
    {
        @Body
    }
</div>

@code {
    private string Initials => string.Join("", (Session.User?.Name ?? "EA").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0])));

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void SignOut()
    {
        Session.SignOut();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
